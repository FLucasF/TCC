# Exemplo de configuração para desenvolvimento local
# Copie para .env e configure conforme sua máquina

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/pousada
DB_USER=postgres
DB_PASSWORD=password

# Aplicação
PORT=7070

# Modo de teste (redireciona e-mails para testes@pousadamarealta.com.br)
# Descomente para ativar:
# HOTEL_TEST_MODE=true

# Desabilitar cópia para arquivo (por padrão, está habilitada)
# Descomente para desabilitar:
# HOTEL_ARCHIVE_DISABLED=true
