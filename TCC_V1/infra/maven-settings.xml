<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven Central through Google's official mirror, for the containers of the runs and of the reviews. Only where the
     same artifacts are downloaded from changes: Maven Central answered 429 on 09/11/2026 after too many parallel builds. -->
<settings>
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <mirrorOf>central</mirrorOf>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
    </mirror>
  </mirrors>
</settings>
