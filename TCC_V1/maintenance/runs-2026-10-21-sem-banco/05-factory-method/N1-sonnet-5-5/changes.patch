+
+    @Test
+    void identifiesTheGuestByExactlyOneKind() throws Exception {
+        String company = "\"companyCnpj\": \"12.345.678/0001-90\", \"companyName\": \"Tecnosul Ltda\",";
+        String passport = "\"guestPassport\": \"X1234567\", \"guestCountry\": \"United Kingdom\",";
+        for (String invalid : new String[] {
+                "",
+                "\"companyCnpj\": \"12.345.678/0001-90\",",
+                "\"guestPassport\": \"X1234567\",",
+                "\"guestCpf\": \"111.222.333-44\"," + company,
+                company + passport,
+                "\"guestCpf\": \" \","}) {
+            HttpResponse<String> response = post("/reservations", reservationWith(invalid));
+            assertEquals(400, response.statusCode(), invalid);
+            assertEquals("INVALID_REQUEST", json.readTree(response.body()).get("error").asText());
+        }
+
+        JsonNode created = json.readTree(post("/reservations", reservationWith(company)).body());
+        assertEquals("Tecnosul Ltda", created.get("companyName").asText());
