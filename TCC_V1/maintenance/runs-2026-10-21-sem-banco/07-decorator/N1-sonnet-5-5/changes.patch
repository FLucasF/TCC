@@ -0,0 +1,16 @@
+package hotel.messages;
+
+/** In which modes of the system a rule is in force. */
+public enum RuleScope {
+    ALWAYS,
+    TEST_MODE_ONLY,
+    OUTSIDE_TEST_MODE_ONLY;
+
+    boolean appliesTo(boolean testMode) {
+        return switch (this) {
+            case ALWAYS -> true;
+            case TEST_MODE_ONLY -> testMode;
+            case OUTSIDE_TEST_MODE_ONLY -> !testMode;
+        };
+    }
+}
diff --git a/src/main/java/hotel/messages/ScopedRule.java b/src/main/java/hotel/messages/ScopedRule.java
new file mode 100644
index 0000000..425ce4c
--- /dev/null
+++ b/src/main/java/hotel/messages/ScopedRule.java
@@ -0,0 +1,16 @@
+package hotel.messages;
+
+public record ScopedRule(RuleScope scope, MessageRule rule) {
+
+    public static ScopedRule always(MessageRule rule) {
+        return new ScopedRule(RuleScope.ALWAYS, rule);
+    }
+
+    public static ScopedRule onlyInTestMode(MessageRule rule) {
+        return new ScopedRule(RuleScope.TEST_MODE_ONLY, rule);
+    }
+
+    public static ScopedRule onlyOutsideTestMode(MessageRule rule) {
+        return new ScopedRule(RuleScope.OUTSIDE_TEST_MODE_ONLY, rule);
+    }
+}
