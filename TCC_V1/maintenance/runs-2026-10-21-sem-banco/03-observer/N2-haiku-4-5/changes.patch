diff --git a/src/main/java/hotel/reservations/FinanceListener.java b/src/main/java/hotel/reservations/FinanceListener.java
new file mode 100644
index 0000000..d3353ba
--- /dev/null
+++ b/src/main/java/hotel/reservations/FinanceListener.java
@@ -0,0 +1,32 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import java.math.BigDecimal;
+
+/** Notifies the finance department of confirmations and refunds. */
+public final class FinanceListener implements ReservationEventListener {
+
+    private final EmailSender emailSender;
+
+    public FinanceListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.amountPaid());
+        emailSender.send("financeiro@pousadamarealta.com.br", subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation) {
+        BigDecimal refund = reservation.refund();
+        if (refund != null && refund.signum() > 0) {
+            String subject = "Reembolso - reserva " + reservation.id();
+            String body = "Valor: " + TextFormat.money(refund);
+            emailSender.send("financeiro@pousadamarealta.com.br", subject, body);
+        }
+    }
+}
diff --git a/src/main/java/hotel/reservations/GovernanceListener.java b/src/main/java/hotel/reservations/GovernanceListener.java
new file mode 100644
index 0000000..8ef5710
--- /dev/null
+++ b/src/main/java/hotel/reservations/GovernanceListener.java
@@ -0,0 +1,37 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+import hotel.rooms.Rooms;
+
+/** Notifies the housekeeping department of confirmations and cancellations. */
+public final class GovernanceListener implements ReservationEventListener {
+
+    private final Rooms rooms;
+    private final EmailSender emailSender;
+
+    public GovernanceListener(Rooms rooms, EmailSender emailSender) {
+        this.rooms = rooms;
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation) {
+        Room room = rooms.find(reservation.roomNumber()).orElseThrow();
+        String subject = "Reserva confirmada - quarto " + room.number();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests();
+        emailSender.send("governanca@pousadamarealta.com.br", subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation) {
+        Room room = rooms.find(reservation.roomNumber()).orElseThrow();
+        String subject = "Reserva cancelada - quarto " + room.number();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut());
+        emailSender.send("governanca@pousadamarealta.com.br", subject, body);
+    }
+}
