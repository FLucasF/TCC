diff --git a/src/main/java/hotel/reservations/FinanceNotifier.java b/src/main/java/hotel/reservations/FinanceNotifier.java
new file mode 100644
index 0000000..bd47975
--- /dev/null
+++ b/src/main/java/hotel/reservations/FinanceNotifier.java
@@ -0,0 +1,35 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** Notifies finance about payments and refunds. */
+public final class FinanceNotifier implements ReservationListener {
+
+    private static final String FINANCE_EMAIL = "financeiro@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public FinanceNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.amountPaid()) + "\n";
+        emailSender.send(FINANCE_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        if (reservation.refund() == null || reservation.refund().compareTo(BigDecimal.ZERO) == 0) {
+            return;
+        }
+        String subject = "Reembolso - reserva " + reservation.id();
+        String body = "Valor a devolver: " + TextFormat.money(reservation.refund()) + "\n";
+        emailSender.send(FINANCE_EMAIL, subject, body);
+    }
+}
diff --git a/src/main/java/hotel/reservations/GuestNotifier.java b/src/main/java/hotel/reservations/GuestNotifier.java
new file mode 100644
index 0000000..4a2abab
--- /dev/null
+++ b/src/main/java/hotel/reservations/GuestNotifier.java
@@ -0,0 +1,39 @@
+package hotel.reservations;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+/** Sends confirmation e-mails to guests. */
+public final class GuestNotifier implements ReservationListener {
+
+    private static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final EmailSender emailSender;
+
+    public GuestNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                confirmationEmailBody(reservation, receipt));
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        // Guest does not receive cancellation e-mails
+    }
+
+    private static String confirmationEmailBody(Reservation reservation, ReservationReceipt receipt) {
+        return "Olá, " + reservation.guest().name() + "!\n\n"
+                + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                + receipt.text() + "\n"
+                + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                + "Até breve!\n";
+    }
+}
diff --git a/src/main/java/hotel/reservations/HousekeepingNotifier.java b/src/main/java/hotel/reservations/HousekeepingNotifier.java
new file mode 100644
index 0000000..f1038ef
--- /dev/null
+++ b/src/main/java/hotel/reservations/HousekeepingNotifier.java
@@ -0,0 +1,37 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+/** Notifies housekeeping about confirmed and cancelled reservations. */
+public final class HousekeepingNotifier implements ReservationListener {
+
+    private static final String HOUSEKEEPING_EMAIL = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public HousekeepingNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + room.number();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests() + "\n";
+        emailSender.send(HOUSEKEEPING_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        if (reservation.amountPaid().signum() == 0) {
+            return;
+        }
+        String subject = "Reserva cancelada - quarto " + room.number();
+        String body = "Datas livres: " + TextFormat.date(reservation.checkIn())
+                + " a " + TextFormat.date(reservation.checkOut()) + "\n";
+        emailSender.send(HOUSEKEEPING_EMAIL, subject, body);
+    }
+}
