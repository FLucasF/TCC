+
+    private static final String RESERVATION_JSON = """
+            {"roomNumber": 201, "guestName": "Carla Dias", "guestEmail": "carla@example.com",
+             "guestCpf": "111.222.333-44", "checkIn": "2027-07-10", "checkOut": "2027-07-12",
