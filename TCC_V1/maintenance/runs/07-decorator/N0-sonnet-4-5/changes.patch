+
+        service.create(reservation);
+        service.confirm(1L);
+
+        List<Message> sent = sentMessages.all();
+        assertEquals(1, sent.size());
+        assertEquals(MessageStatus.BLOCKED, sent.get(0).status());
+        assertEquals("ana.gmail.com", sent.get(0).to());
