+package hotel.messages;
+
+import java.util.List;
+
+/** The rules of each installation of the system. */
+public final class EmailRules {
+
+    private EmailRules() {
+    }
+
+    /** Pousada Maré Alta. The order matters: an invalid address is blocked before anything else touches it. */
+    public static List<ScopedRule> mareAlta() {
+        return List.of(
+                new ScopedRule(RuleScope.ALWAYS, new BlockInvalidAddress()),
+                new ScopedRule(RuleScope.TEST_MODE_ONLY, new RedirectToTests()),
+                new ScopedRule(RuleScope.NORMAL_MODE_ONLY, new CopyToArchive()));
+    }
+}
diff --git a/src/main/java/hotel/messages/EmailSender.java b/src/main/java/hotel/messages/EmailSender.java
index 3eee255..b3f02e1 100644
--- a/src/main/java/hotel/messages/EmailSender.java
+++ b/src/main/java/hotel/messages/EmailSender.java
@@ -1,15 +1,44 @@
 package hotel.messages;
 
-/** Sends e-mails to guests. Every e-mail sent is kept in the list of sent messages. */
+import java.util.List;
+
+/**
+ * Sends e-mails to guests. The rules of the installation decide what happens to each one, and every e-mail, sent or
+ * blocked, is kept in the list of sent messages.
+ */
 public final class EmailSender {
 
     private final SentMessages sentMessages;
+    private final boolean testMode;
+    private final List<ScopedRule> rules;
 
     public EmailSender(SentMessages sentMessages) {
+        this(sentMessages, false, List.of());
+    }
+
+    public EmailSender(SentMessages sentMessages, boolean testMode, List<ScopedRule> rules) {
         this.sentMessages = sentMessages;
+        this.testMode = testMode;
+        this.rules = rules;
     }
 
     public Message send(String to, String subject, String body) {
-        return sentMessages.add("EMAIL", to, subject, body);
+        Draft draft = new Draft(to, subject, body);
+        for (ScopedRule scoped : rules) {
+            if (draft.blocked()) {
+                break;
+            }
+            if (scoped.scope().covers(testMode)) {
+                draft = scoped.rule().apply(draft);
+            }
+        }
+        if (draft.blocked()) {
+            return sentMessages.add("EMAIL", to, subject, body, MessageStatus.BLOCKED);
+        }
+        Message message = sentMessages.add("EMAIL", draft.to(), draft.subject(), draft.body(), MessageStatus.SENT);
+        for (Draft copy : draft.copies()) {
+            sentMessages.add("EMAIL", copy.to(), copy.subject(), copy.body(), MessageStatus.SENT);
+        }
+        return message;
     }
 }
