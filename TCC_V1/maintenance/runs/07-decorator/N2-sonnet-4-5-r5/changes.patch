@@ -0,0 +1,28 @@
+package hotel.messages;
+
+/**
+ * Blocks messages sent to invalid e-mail addresses, so the front desk can call the guest instead.
+ * Valid means one @, something before it, and a name with at least one dot after it.
+ */
+public final class EmailValidator implements EmailFilter {
+
+    @Override
+    public FilterResult apply(OutgoingMessage message) {
+        if (isValid(message.to())) {
+            return FilterResult.allow(message);
+        }
+        return FilterResult.block(message);
+    }
+
+    private boolean isValid(String email) {
+        int atIndex = email.indexOf('@');
+        if (atIndex == -1 || atIndex != email.lastIndexOf('@')) {
+            return false; // no @ or more than one
+        }
+        if (atIndex == 0) {
+            return false; // nothing before @
+        }
+        String domain = email.substring(atIndex + 1);
+        return domain.contains(".") && !domain.startsWith(".") && !domain.endsWith(".");
+    }
+}
diff --git a/src/main/java/hotel/messages/FilterChain.java b/src/main/java/hotel/messages/FilterChain.java
new file mode 100644
index 0000000..c21baa9
--- /dev/null
+++ b/src/main/java/hotel/messages/FilterChain.java
@@ -0,0 +1,27 @@
+package hotel.messages;
+
+import java.util.List;
+
+/**
+ * Applies a sequence of filters to decide what happens to each message: it can go through
+ * (unchanged or transformed), be blocked, or generate extra messages.
+ */
+public final class FilterChain {
+
+    private final List<EmailFilter> filters;
+
+    public FilterChain(List<EmailFilter> filters) {
+        this.filters = List.copyOf(filters);
+    }
+
+    public FilterResult apply(OutgoingMessage message) {
+        FilterResult result = FilterResult.allow(message);
+        for (EmailFilter filter : filters) {
+            if (result.isBlocked()) {
+                break;
+            }
+            result = filter.apply(result.message());
+        }
+        return result;
+    }
+}
diff --git a/src/main/java/hotel/messages/FilterResult.java b/src/main/java/hotel/messages/FilterResult.java
new file mode 100644
index 0000000..09b8b0c
--- /dev/null
+++ b/src/main/java/hotel/messages/FilterResult.java
@@ -0,0 +1,52 @@
+package hotel.messages;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * What happened to a message after the filters processed it: it can go through (possibly transformed),
+ * be blocked, or generate extra messages.
+ */
+public final class FilterResult {
+
+    private final OutgoingMessage message;
+    private final MessageStatus status;
+    private final List<OutgoingMessage> extraMessages;
+
+    private FilterResult(OutgoingMessage message, MessageStatus status, List<OutgoingMessage> extraMessages) {
+        this.message = message;
+        this.status = status;
+        this.extraMessages = List.copyOf(extraMessages);
+    }
+
+    /** The message goes through, unchanged or transformed. */
+    public static FilterResult allow(OutgoingMessage message) {
+        return new FilterResult(message, MessageStatus.SENT, List.of());
+    }
+
+    /** The message goes through and generates extra messages (like a copy for archiving). */
+    public static FilterResult allowWithExtra(OutgoingMessage message, OutgoingMessage... extra) {
+        return new FilterResult(message, MessageStatus.SENT, List.of(extra));
+    }
+
+    /** The message is blocked. */
+    public static FilterResult block(OutgoingMessage message) {
+        return new FilterResult(message, MessageStatus.BLOCKED, List.of());
+    }
+
+    public OutgoingMessage message() {
+        return message;
+    }
+
+    public MessageStatus status() {
+        return status;
+    }
+
+    public List<OutgoingMessage> extraMessages() {
+        return extraMessages;
+    }
+
+    public boolean isBlocked() {
+        return status == MessageStatus.BLOCKED;
+    }
+}
