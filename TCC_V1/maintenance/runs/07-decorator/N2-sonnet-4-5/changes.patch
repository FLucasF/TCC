+        sender.send("ana@gmail.com", "Reserva confirmada", "Olá Ana");
+
+        List<Message> all = sentMessages.all();
+        assertEquals(1, all.size());
+        assertEquals("testes@pousadamarealta.com.br", all.get(0).to());
