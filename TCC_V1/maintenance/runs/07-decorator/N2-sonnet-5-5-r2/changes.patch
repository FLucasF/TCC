index 0000000..7738a7b
--- /dev/null
+++ b/src/main/java/hotel/messages/BlockInvalidAddress.java
@@ -0,0 +1,35 @@
+package hotel.messages;
+
+/** Does not send to a mistyped address: keeps the message as BLOCKED, so the front desk calls the guest. */
+public final class BlockInvalidAddress implements MessageSender {
+
+    private final SentMessages sentMessages;
+    private final MessageSender next;
+
+    public BlockInvalidAddress(SentMessages sentMessages, MessageSender next) {
+        this.sentMessages = sentMessages;
+        this.next = next;
+    }
+
+    @Override
+    public Message send(String to, String subject, String body) {
+        if (isValid(to)) {
+            return next.send(to, subject, body);
+        }
+        return sentMessages.add("EMAIL", to, subject, body, MessageStatus.BLOCKED);
+    }
+
+    /** One @, something before it, and after it a name with a dot in the middle (ana@gmail.com). */
+    static boolean isValid(String address) {
+        if (address == null) {
+            return false;
+        }
+        int at = address.indexOf('@');
+        if (at <= 0 || address.indexOf('@', at + 1) >= 0) {
+            return false;
+        }
+        String domain = address.substring(at + 1);
+        int lastDot = domain.lastIndexOf('.');
+        return domain.indexOf('.') > 0 && lastDot < domain.length() - 1;
+    }
+}
diff --git a/src/main/java/hotel/messages/CopyToArchive.java b/src/main/java/hotel/messages/CopyToArchive.java
new file mode 100644
index 0000000..d868446
--- /dev/null
+++ b/src/main/java/hotel/messages/CopyToArchive.java
@@ -0,0 +1,22 @@
+package hotel.messages;
+
+/** Every message that was sent also goes, as a copy, to the accountant's archive. Blocked ones have no copy. */
+public final class CopyToArchive implements MessageSender {
+
+    static final String ARCHIVE_ADDRESS = "arquivo@pousadamarealta.com.br";
+
+    private final MessageSender next;
+
+    public CopyToArchive(MessageSender next) {
+        this.next = next;
+    }
+
+    @Override
+    public Message send(String to, String subject, String body) {
+        Message message = next.send(to, subject, body);
+        if (message.status() == MessageStatus.SENT) {
+            next.send(ARCHIVE_ADDRESS, "[Cópia] " + subject, body);
+        }
+        return message;
+    }
+}
