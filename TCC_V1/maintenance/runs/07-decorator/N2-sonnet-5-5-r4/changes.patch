new file mode 100644
index 0000000..3070879
--- /dev/null
+++ b/src/main/java/hotel/messages/AddressValidation.java
@@ -0,0 +1,35 @@
+package hotel.messages;
+
+/** Does not send to a malformed address: the message is kept as blocked, with the address as it was typed. */
+public final class AddressValidation implements MessageSender {
+
+    private final MessageSender next;
+    private final SentMessages sentMessages;
+
+    public AddressValidation(MessageSender next, SentMessages sentMessages) {
+        this.next = next;
+        this.sentMessages = sentMessages;
+    }
+
+    @Override
+    public Message send(String to, String subject, String body) {
+        if (!isValid(to)) {
+            return sentMessages.add("EMAIL", to, subject, body, MessageStatus.BLOCKED);
+        }
+        return next.send(to, subject, body);
+    }
+
+    /** One @, something before it, and after it a name with a dot in the middle. */
+    private static boolean isValid(String address) {
+        if (address == null) {
+            return false;
+        }
+        int at = address.indexOf('@');
+        if (at < 1 || at != address.lastIndexOf('@')) {
+            return false;
+        }
+        String domain = address.substring(at + 1);
+        int dot = domain.indexOf('.');
+        return dot > 0 && domain.lastIndexOf('.') < domain.length() - 1 && !domain.endsWith(".");
+    }
+}
diff --git a/src/main/java/hotel/messages/ArchiveCopy.java b/src/main/java/hotel/messages/ArchiveCopy.java
new file mode 100644
index 0000000..1c534f1
--- /dev/null
+++ b/src/main/java/hotel/messages/ArchiveCopy.java
@@ -0,0 +1,22 @@
+package hotel.messages;
+
+/** Every message sent also goes, as a copy, to the address the accountant keeps. Blocked messages have no copy. */
+public final class ArchiveCopy implements MessageSender {
+
+    static final String ARCHIVE_ADDRESS = "arquivo@pousadamarealta.com.br";
+
+    private final MessageSender next;
+
+    public ArchiveCopy(MessageSender next) {
+        this.next = next;
+    }
+
+    @Override
+    public Message send(String to, String subject, String body) {
+        Message message = next.send(to, subject, body);
+        if (message.status() == MessageStatus.SENT) {
+            next.send(ARCHIVE_ADDRESS, "[Cópia] " + subject, body);
+        }
+        return message;
+    }
+}
