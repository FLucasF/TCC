diff --git a/src/main/java/hotel/messages/EmailValidator.java b/src/main/java/hotel/messages/EmailValidator.java
new file mode 100644
index 0000000..430c96e
--- /dev/null
+++ b/src/main/java/hotel/messages/EmailValidator.java
@@ -0,0 +1,37 @@
+package hotel.messages;
+
+public final class EmailValidator {
+
+    private EmailValidator() {}
+
+    public static boolean isValid(String email) {
+        if (email == null || email.isBlank()) {
+            return false;
+        }
+        int atCount = 0;
+        int atIndex = -1;
+        for (int i = 0; i < email.length(); i++) {
+            if (email.charAt(i) == '@') {
+                atCount++;
+                atIndex = i;
+            }
+        }
+        if (atCount != 1) {
+            return false;
+        }
+        if (atIndex == 0) {
+            return false;
+        }
+        String domain = email.substring(atIndex + 1);
+        if (domain.isEmpty()) {
+            return false;
+        }
+        int dotCount = 0;
+        for (int i = 0; i < domain.length(); i++) {
+            if (domain.charAt(i) == '.') {
+                dotCount++;
+            }
+        }
+        return dotCount >= 1;
+    }
+}
