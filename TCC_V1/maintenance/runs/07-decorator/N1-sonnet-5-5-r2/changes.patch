new file mode 100644
index 0000000..a20fa2f
--- /dev/null
+++ b/src/main/java/hotel/messages/Scope.java
@@ -0,0 +1,16 @@
+package hotel.messages;
+
+/** When a rule is in force: always, only in test mode, or only outside of it. */
+public enum Scope {
+    ALWAYS,
+    TEST_MODE_ONLY,
+    OUTSIDE_TEST_MODE_ONLY;
+
+    boolean covers(boolean testMode) {
+        return switch (this) {
+            case ALWAYS -> true;
+            case TEST_MODE_ONLY -> testMode;
+            case OUTSIDE_TEST_MODE_ONLY -> !testMode;
+        };
+    }
+}
diff --git a/src/main/java/hotel/messages/ScopedRule.java b/src/main/java/hotel/messages/ScopedRule.java
new file mode 100644
index 0000000..8326728
--- /dev/null
+++ b/src/main/java/hotel/messages/ScopedRule.java
@@ -0,0 +1,27 @@
+package hotel.messages;
+
+import java.util.List;
+
+/** Puts a rule in force only where its {@link Scope} says so. */
+final class ScopedRule implements MessageRule {
+
+    private final Scope scope;
+    private final boolean testMode;
+    private final MessageRule rule;
+
+    ScopedRule(Scope scope, boolean testMode, MessageRule rule) {
+        this.scope = scope;
+        this.testMode = testMode;
+        this.rule = rule;
+    }
+
+    @Override
+    public Draft apply(Draft draft) {
+        return scope.covers(testMode) ? rule.apply(draft) : draft;
+    }
+
+    @Override
+    public List<Draft> extrasFor(Draft sent) {
+        return scope.covers(testMode) ? rule.extrasFor(sent) : List.of();
+    }
+}
