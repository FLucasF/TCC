+package hotel.messages;
+
+/** Sends the message to the test address instead of the real one, saying who it was meant for. */
+final class TestRedirect implements MessageRule {
+
+    static final String TEST_ADDRESS = "testes@pousadamarealta.com.br";
+
+    @Override
+    public Draft apply(Draft draft) {
+        if (draft.isBlocked()) {
+            return draft;
+        }
+        return new Draft(
+                TEST_ADDRESS,
+                "[TESTE] " + draft.subject(),
+                "Destinatário original: " + draft.to() + "\n" + draft.body());
+    }
+}
diff --git a/src/main/java/hotel/messages/ValidAddress.java b/src/main/java/hotel/messages/ValidAddress.java
new file mode 100644
index 0000000..75c2a1e
--- /dev/null
+++ b/src/main/java/hotel/messages/ValidAddress.java
@@ -0,0 +1,19 @@
+package hotel.messages;
+
+/** Blocks a message whose address is not like ana@gmail.com: one @, something before it and a dotted name after. */
+final class ValidAddress implements MessageRule {
+
+    @Override
+    public Draft apply(Draft draft) {
+        return isValid(draft.to()) ? draft : draft.blocked();
+    }
+
+    static boolean isValid(String address) {
+        int at = address.indexOf('@');
+        if (at < 1 || at != address.lastIndexOf('@')) {
+            return false;
+        }
+        String domain = address.substring(at + 1);
+        return domain.indexOf('.', 1) > 0 && !domain.startsWith(".") && !domain.endsWith(".");
+    }
+}
