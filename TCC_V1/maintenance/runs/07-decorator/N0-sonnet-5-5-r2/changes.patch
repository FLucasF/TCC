diff --git a/src/main/java/hotel/messages/MessagePolicy.java b/src/main/java/hotel/messages/MessagePolicy.java
new file mode 100644
index 0000000..5aaf3d2
--- /dev/null
+++ b/src/main/java/hotel/messages/MessagePolicy.java
@@ -0,0 +1,80 @@
+package hotel.messages;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/** The rules one installation of the system uses, each one with the scope where it is in force. */
+public final class MessagePolicy {
+
+    static final String TEST_ADDRESS = "testes@pousadamarealta.com.br";
+    static final String ARCHIVE_ADDRESS = "arquivo@pousadamarealta.com.br";
+
+    private record Scoped<T>(Scope scope, T rule) {
+    }
+
+    private final boolean testMode;
+    private final List<Scoped<MessageRules.Block>> blocks = new ArrayList<>();
+    private final List<Scoped<MessageRules.Rewrite>> rewrites = new ArrayList<>();
+    private final List<Scoped<MessageRules.Copy>> copies = new ArrayList<>();
+
+    public MessagePolicy(boolean testMode) {
+        this.testMode = testMode;
+    }
+
+    /** The inn's usual rules; the test mode comes from HOTEL_TEST_MODE=true. */
+    public static MessagePolicy fromEnvironment(Map<String, String> environment) {
+        return standard("true".equalsIgnoreCase(environment.getOrDefault("HOTEL_TEST_MODE", "").trim()));
+    }
+
+    /** Invalid addresses are blocked; in test mode everything is redirected, otherwise the archive gets a copy. */
+    public static MessagePolicy standard(boolean testMode) {
+        return new MessagePolicy(testMode)
+                .block(Scope.ALWAYS, MessageRules.invalidAddress())
+                .rewrite(Scope.TEST_ONLY, MessageRules.redirectTo(TEST_ADDRESS))
+                .copy(Scope.LIVE_ONLY, MessageRules.archiveTo(ARCHIVE_ADDRESS));
+    }
+
+    public MessagePolicy block(Scope scope, MessageRules.Block rule) {
+        blocks.add(new Scoped<>(scope, rule));
+        return this;
+    }
+
+    public MessagePolicy rewrite(Scope scope, MessageRules.Rewrite rule) {
+        rewrites.add(new Scoped<>(scope, rule));
+        return this;
+    }
+
+    public MessagePolicy copy(Scope scope, MessageRules.Copy rule) {
+        copies.add(new Scoped<>(scope, rule));
+        return this;
+    }
+
+    boolean blocks(Email original) {
+        return blocks.stream().filter(this::applies).anyMatch(b -> b.rule().blocks(original));
+    }
+
+    Email rewrite(Email email) {
+        Email result = email;
+        for (Scoped<MessageRules.Rewrite> rewrite : rewrites) {
+            if (applies(rewrite)) {
+                result = rewrite.rule().rewrite(result);
+            }
+        }
+        return result;
+    }
+
+    List<Email> copiesOf(Email sent) {
+        List<Email> result = new ArrayList<>();
+        for (Scoped<MessageRules.Copy> copy : copies) {
+            if (applies(copy)) {
+                copy.rule().copyOf(sent).ifPresent(result::add);
+            }
+        }
+        return result;
+    }
+
+    private boolean applies(Scoped<?> scoped) {
+        return scoped.scope().appliesIn(testMode);
+    }
+}
diff --git a/src/main/java/hotel/messages/MessageRules.java b/src/main/java/hotel/messages/MessageRules.java
new file mode 100644
index 0000000..24e2b2a
--- /dev/null
+++ b/src/main/java/hotel/messages/MessageRules.java
@@ -0,0 +1,61 @@
+package hotel.messages;
+
+import java.util.Optional;
+
+/**
+ * The kinds of rule an installation can combine in a {@link MessagePolicy}. A new rule (quiet hours, a daily limit
+ * per guest...) is one more implementation of one of these, added to the policy with the scope it should have.
+ */
+public final class MessageRules {
+
+    private MessageRules() {
+    }
+
+    /** Holds a message back. It is judged as the original e-mail, with the address the guest gave. */
+    public interface Block {
+        boolean blocks(Email original);
+    }
+
+    /** Changes what is actually sent (the message kept as SENT is the changed one). */
+    public interface Rewrite {
+        Email rewrite(Email email);
+    }
+
+    /** After a message is sent, asks for another one to be kept alongside it. */
+    public interface Copy {
+        Optional<Email> copyOf(Email sent);
+    }
+
+    /** An address is valid with a single @, something before it and a name with a dot in the middle after it. */
+    public static Block invalidAddress() {
+        return original -> !isValidAddress(original.to());
+    }
+
+    static boolean isValidAddress(String address) {
+        if (address == null) {
+            return false;
+        }
+        int at = address.indexOf('@');
+        if (at < 1 || at != address.lastIndexOf('@')) {
+            return false;
+        }
+        String domain = address.substring(at + 1);
+        int lastDot = domain.lastIndexOf('.');
+        return domain.indexOf('.') > 0 && lastDot < domain.length() - 1 && !domain.contains("..")
+                && domain.chars().noneMatch(Character::isWhitespace)
+                && address.chars().noneMatch(Character::isWhitespace);
+    }
+
+    /** Everything goes to one test address, saying in the subject and the text who it was meant for. */
+    public static Rewrite redirectTo(String testAddress) {
+        return email -> new Email(
+                testAddress,
+                "[TESTE] " + email.subject(),
+                "Destinatário original: " + email.to() + "\n" + email.body());
+    }
+
+    /** Every message sent has a copy for the archive, with the same text. */
+    public static Copy archiveTo(String archiveAddress) {
+        return sent -> Optional.of(new Email(archiveAddress, "[Cópia] " + sent.subject(), sent.body()));
+    }
+}
