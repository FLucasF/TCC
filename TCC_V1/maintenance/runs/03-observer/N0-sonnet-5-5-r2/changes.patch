index 0000000..ae90e29
--- /dev/null
+++ b/src/main/java/hotel/notifications/Finance.java
@@ -0,0 +1,40 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Tells the finance team about payments received and refunds to pay back. */
+public final class Finance implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    public Finance(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                address,
+                "Pagamento recebido - reserva " + reservation.id(),
+                "Pagamento da reserva " + reservation.id() + " recebido.\n"
+                        + "Valor pago: " + TextFormat.money(reservation.amountPaid()) + "\n");
+    }
+
+    @Override
+    public void onConfirmedReservationCancelled(Reservation reservation, Room room) {
+        if (reservation.refund() == null || reservation.refund().signum() <= 0) {
+            return;
+        }
+        emailSender.send(
+                address,
+                "Reembolso - reserva " + reservation.id(),
+                "A reserva " + reservation.id() + " foi cancelada.\n"
+                        + "Valor a devolver: " + TextFormat.money(reservation.refund()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/Governance.java b/src/main/java/hotel/notifications/Governance.java
new file mode 100644
index 0000000..ed1c0ad
--- /dev/null
+++ b/src/main/java/hotel/notifications/Governance.java
@@ -0,0 +1,40 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Tells housekeeping which rooms to prepare, and which ones were freed. */
+public final class Governance implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    public Governance(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                address,
+                "Reserva confirmada - quarto " + room.number(),
+                "Reserva " + reservation.id() + " confirmada para o quarto " + room.number() + ".\n"
+                        + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void onConfirmedReservationCancelled(Reservation reservation, Room room) {
+        emailSender.send(
+                address,
+                "Reserva cancelada - quarto " + room.number(),
+                "Reserva " + reservation.id() + " cancelada. O quarto " + room.number() + " ficou livre nas datas:\n"
+                        + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationListener.java b/src/main/java/hotel/reservations/ReservationListener.java
new file mode 100644
index 0000000..b9ceed4
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationListener.java
@@ -0,0 +1,18 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+
+/**
+ * Someone who wants to hear about what happens to reservations. Implement only the events of interest;
+ * the service tells every registered listener, so a new interested party needs no change to the service.
+ */
+public interface ReservationListener {
+
+    /** The guest paid and the reservation is now confirmed. */
+    default void onConfirmed(Reservation reservation, Room room) {
+    }
+
+    /** A reservation that had been confirmed was cancelled; its refund is already set. */
+    default void onConfirmedReservationCancelled(Reservation reservation, Room room) {
+    }
+}
