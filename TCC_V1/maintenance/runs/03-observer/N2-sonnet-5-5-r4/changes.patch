diff --git a/src/main/java/hotel/notifications/FinanceEmail.java b/src/main/java/hotel/notifications/FinanceEmail.java
new file mode 100644
index 0000000..b747345
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceEmail.java
@@ -0,0 +1,38 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.reservations.ReservationStatus;
+
+/** Tells finance about the payments received and the refunds to make. */
+public final class FinanceEmail implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    public FinanceEmail(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation) {
+        emailSender.send(
+                address,
+                "Pagamento recebido - reserva " + reservation.id(),
+                "Valor pago: " + TextFormat.money(reservation.amountPaid()) + "\n");
+    }
+
+    @Override
+    public void cancelled(Reservation reservation, ReservationStatus previousStatus) {
+        if (previousStatus != ReservationStatus.CONFIRMED || reservation.refund().signum() <= 0) {
+            return;
+        }
+        emailSender.send(
+                address,
+                "Reembolso - reserva " + reservation.id(),
+                "Valor a devolver: " + TextFormat.money(reservation.refund()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/GuestReceiptEmail.java b/src/main/java/hotel/notifications/GuestReceiptEmail.java
new file mode 100644
index 0000000..8fd652d
--- /dev/null
+++ b/src/main/java/hotel/notifications/GuestReceiptEmail.java
@@ -0,0 +1,35 @@
+package hotel.notifications;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Rooms;
+
+/** Sends the guest the receipt when the reservation is confirmed. */
+public final class GuestReceiptEmail implements ReservationListener {
+
+    static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final Rooms rooms;
+    private final EmailSender emailSender;
+
+    public GuestReceiptEmail(Rooms rooms, EmailSender emailSender) {
+        this.rooms = rooms;
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation) {
+        ReservationReceipt receipt = new ReservationReceipt(
+                reservation, rooms.find(reservation.roomNumber()).orElseThrow());
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                "Olá, " + reservation.guest().name() + "!\n\n"
+                        + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                        + receipt.text() + "\n"
+                        + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                        + "Até breve!\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/HousekeepingEmail.java b/src/main/java/hotel/notifications/HousekeepingEmail.java
new file mode 100644
index 0000000..33bded7
--- /dev/null
+++ b/src/main/java/hotel/notifications/HousekeepingEmail.java
@@ -0,0 +1,41 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.reservations.ReservationStatus;
+
+/** Tells housekeeping when a room has to be prepared and when its nights are free again. */
+public final class HousekeepingEmail implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    public HousekeepingEmail(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation) {
+        emailSender.send(
+                address,
+                "Reserva confirmada - quarto " + reservation.roomNumber(),
+                "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void cancelled(Reservation reservation, ReservationStatus previousStatus) {
+        if (previousStatus != ReservationStatus.CONFIRMED) {
+            return;
+        }
+        emailSender.send(
+                address,
+                "Reserva cancelada - quarto " + reservation.roomNumber(),
+                "Datas liberadas: de " + TextFormat.date(reservation.checkIn())
+                        + " a " + TextFormat.date(reservation.checkOut()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationListener.java b/src/main/java/hotel/reservations/ReservationListener.java
new file mode 100644
index 0000000..e7a1824
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationListener.java
@@ -0,0 +1,13 @@
+package hotel.reservations;
+
+/** Someone who reacts to what happens to a reservation. Each listener decides what, if anything, to do. */
+public interface ReservationListener {
+
+    /** The guest paid and the reservation is now confirmed. */
+    default void confirmed(Reservation reservation) {
+    }
+
+    /** The reservation was cancelled; {@code previousStatus} says whether it had been confirmed. */
+    default void cancelled(Reservation reservation, ReservationStatus previousStatus) {
+    }
+}
