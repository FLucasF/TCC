diff --git a/src/main/java/hotel/notifications/ReservationEventListener.java b/src/main/java/hotel/notifications/ReservationEventListener.java
new file mode 100644
index 0000000..bc8a090
--- /dev/null
+++ b/src/main/java/hotel/notifications/ReservationEventListener.java
@@ -0,0 +1,14 @@
+package hotel.notifications;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/** Listens to reservation lifecycle events and reacts to them. */
+public interface ReservationEventListener {
+
+    /** Called when a reservation is confirmed (the guest has paid). */
+    void onReservationConfirmed(Reservation reservation, Room room);
+
+    /** Called when a confirmed reservation is cancelled. */
+    void onReservationCancelled(Reservation reservation, Room room);
+}
diff --git a/src/main/java/hotel/notifications/ReservationNotifications.java b/src/main/java/hotel/notifications/ReservationNotifications.java
new file mode 100644
index 0000000..16eb74e
--- /dev/null
+++ b/src/main/java/hotel/notifications/ReservationNotifications.java
@@ -0,0 +1,28 @@
+package hotel.notifications;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Dispatches reservation events to all registered listeners. */
+public final class ReservationNotifications {
+
+    private final List<ReservationEventListener> listeners = new ArrayList<>();
+
+    public void addListener(ReservationEventListener listener) {
+        listeners.add(listener);
+    }
+
+    public void notifyConfirmed(Reservation reservation, Room room) {
+        for (ReservationEventListener listener : listeners) {
+            listener.onReservationConfirmed(reservation, room);
+        }
+    }
+
+    public void notifyCancelled(Reservation reservation, Room room) {
+        for (ReservationEventListener listener : listeners) {
+            listener.onReservationCancelled(reservation, room);
+        }
+    }
+}
