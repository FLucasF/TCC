diff --git a/src/main/java/hotel/notifications/FinanceListener.java b/src/main/java/hotel/notifications/FinanceListener.java
new file mode 100644
index 0000000..941b722
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceListener.java
@@ -0,0 +1,36 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** Notifies finance about payment received and refunds. */
+public final class FinanceListener implements ReservationEventListener {
+
+    private static final String FINANCE_EMAIL = "financeiro@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public FinanceListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.amountPaid());
+        emailSender.send(FINANCE_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        BigDecimal refund = reservation.refund();
+        if (refund != null && refund.signum() > 0) {
+            String subject = "Reembolso - reserva " + reservation.id();
+            String body = "Valor: " + TextFormat.money(refund);
+            emailSender.send(FINANCE_EMAIL, subject, body);
+        }
+    }
+}
diff --git a/src/main/java/hotel/notifications/HousekeepingListener.java b/src/main/java/hotel/notifications/HousekeepingListener.java
new file mode 100644
index 0000000..4cb9073
--- /dev/null
+++ b/src/main/java/hotel/notifications/HousekeepingListener.java
@@ -0,0 +1,35 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/** Notifies housekeeping (governança) about confirmed and cancelled reservations. */
+public final class HousekeepingListener implements ReservationEventListener {
+
+    private static final String HOUSEKEEPING_EMAIL = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public HousekeepingListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + reservation.roomNumber();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn())
+                + "\nSaída: " + TextFormat.date(reservation.checkOut())
+                + "\nHóspedes: " + reservation.guests();
+        emailSender.send(HOUSEKEEPING_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        String subject = "Reserva cancelada - quarto " + reservation.roomNumber();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn())
+                + "\nSaída: " + TextFormat.date(reservation.checkOut());
+        emailSender.send(HOUSEKEEPING_EMAIL, subject, body);
+    }
+}
