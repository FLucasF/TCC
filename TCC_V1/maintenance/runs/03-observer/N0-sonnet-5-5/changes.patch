+++ b/src/main/java/hotel/notifications/HousekeepingNotifier.java
@@ -0,0 +1,41 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Tells housekeeping (governança) when a room has to be prepared or is freed. */
+public final class HousekeepingNotifier implements ReservationListener {
+
+    public static final String ADDRESS = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public HousekeepingNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                ADDRESS,
+                "Reserva confirmada - quarto " + room.number(),
+                "Reserva " + reservation.id() + " confirmada para o quarto " + room.number() + ".\n"
+                        + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void onConfirmedReservationCancelled(Reservation reservation, Room room) {
+        emailSender.send(
+                ADDRESS,
+                "Reserva cancelada - quarto " + room.number(),
+                "A reserva " + reservation.id() + " foi cancelada e o quarto " + room.number()
+                        + " ficou livre nas datas:\n"
+                        + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationListener.java b/src/main/java/hotel/reservations/ReservationListener.java
new file mode 100644
index 0000000..fea697c
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationListener.java
@@ -0,0 +1,18 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+
+/**
+ * Someone who wants to know what happens to reservations. Add a listener to the service to be told;
+ * new kinds of news become new default methods here, so existing listeners are not affected.
+ */
+public interface ReservationListener {
+
+    /** The guest paid and the reservation is now confirmed. */
+    default void onConfirmed(Reservation reservation, Room room) {
+    }
+
+    /** A confirmed (paid) reservation was cancelled; {@code reservation.refund()} says what goes back. */
+    default void onConfirmedReservationCancelled(Reservation reservation, Room room) {
+    }
+}
