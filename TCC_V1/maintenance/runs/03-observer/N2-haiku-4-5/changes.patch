+++ b/src/main/java/hotel/reservations/GoverningStaffNotifier.java
@@ -0,0 +1,41 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+public final class GoverningStaffNotifier implements ReservationListener {
+
+    private final EmailSender emailSender;
+
+    public GoverningStaffNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmation(Reservation reservation, Room room) {
+        emailSender.send(
+                "governanca@pousadamarealta.com.br",
+                "Reserva confirmada - quarto " + reservation.roomNumber(),
+                confirmationEmailBody(reservation));
+    }
+
+    @Override
+    public void onCancellation(Reservation reservation, Room room) {
+        emailSender.send(
+                "governanca@pousadamarealta.com.br",
+                "Reserva cancelada - quarto " + reservation.roomNumber(),
+                cancellationEmailBody(reservation));
+    }
+
+    private static String confirmationEmailBody(Reservation reservation) {
+        return "Entrada: " + TextFormat.date(reservation.checkIn())
+                + "\nSaída: " + TextFormat.date(reservation.checkOut())
+                + "\nHóspedes: " + reservation.guests();
+    }
+
+    private static String cancellationEmailBody(Reservation reservation) {
+        return "Entrada: " + TextFormat.date(reservation.checkIn())
+                + "\nSaída: " + TextFormat.date(reservation.checkOut());
+    }
+}
diff --git a/src/main/java/hotel/reservations/GuestNotifier.java b/src/main/java/hotel/reservations/GuestNotifier.java
new file mode 100644
index 0000000..f6cefbb
--- /dev/null
+++ b/src/main/java/hotel/reservations/GuestNotifier.java
@@ -0,0 +1,36 @@
+package hotel.reservations;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+public final class GuestNotifier implements ReservationListener {
+
+    private static final String HOTEL_NAME = "Pousada Maré Alta";
+    private final EmailSender emailSender;
+
+    public GuestNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmation(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                confirmationEmailBody(reservation, receipt));
+    }
+
+    @Override
+    public void onCancellation(Reservation reservation, Room room) {
+    }
+
+    private static String confirmationEmailBody(Reservation reservation, ReservationReceipt receipt) {
+        return "Olá, " + reservation.guest().name() + "!\n\n"
+                + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                + receipt.text() + "\n"
+                + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                + "Até breve!\n";
+    }
+}
