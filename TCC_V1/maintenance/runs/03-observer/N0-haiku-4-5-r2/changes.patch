+++ b/src/main/java/hotel/notifications/GuestNotifier.java
@@ -0,0 +1,38 @@
+package hotel.notifications;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+public final class GuestNotifier implements Notifier {
+
+    static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final EmailSender emailSender;
+
+    public GuestNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                confirmationEmailBody(reservation, receipt));
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+    }
+
+    private static String confirmationEmailBody(Reservation reservation, ReservationReceipt receipt) {
+        return "Olá, " + reservation.guest().name() + "!\n\n"
+                + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                + receipt.text() + "\n"
+                + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                + "Até breve!\n";
+    }
+}
diff --git a/src/main/java/hotel/notifications/NotificationDispatcher.java b/src/main/java/hotel/notifications/NotificationDispatcher.java
new file mode 100644
index 0000000..91f7c9b
--- /dev/null
+++ b/src/main/java/hotel/notifications/NotificationDispatcher.java
@@ -0,0 +1,27 @@
+package hotel.notifications;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class NotificationDispatcher {
+
+    private final List<Notifier> notifiers = new ArrayList<>();
+
+    public void register(Notifier notifier) {
+        notifiers.add(notifier);
+    }
+
+    public void notifyReservationConfirmed(Reservation reservation, Room room) {
+        for (Notifier notifier : notifiers) {
+            notifier.onReservationConfirmed(reservation, room);
+        }
+    }
+
+    public void notifyReservationCancelled(Reservation reservation, Room room) {
+        for (Notifier notifier : notifiers) {
+            notifier.onReservationCancelled(reservation, room);
+        }
+    }
+}
