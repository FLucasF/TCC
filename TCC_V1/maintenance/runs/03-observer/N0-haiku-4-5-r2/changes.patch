new file mode 100644
index 0000000..01850d2
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceNotifier.java
@@ -0,0 +1,33 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+public final class FinanceNotifier implements Notifier {
+
+    private final String email;
+    private final EmailSender emailSender;
+
+    public FinanceNotifier(String email, EmailSender emailSender) {
+        this.email = email;
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.amountPaid()) + "\n";
+        emailSender.send(email, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        if (reservation.refund() != null && reservation.refund().signum() > 0) {
+            String subject = "Reembolso - reserva " + reservation.id();
+            String body = "Valor: " + TextFormat.money(reservation.refund()) + "\n";
+            emailSender.send(email, subject, body);
+        }
+    }
+}
diff --git a/src/main/java/hotel/notifications/GovernanceNotifier.java b/src/main/java/hotel/notifications/GovernanceNotifier.java
new file mode 100644
index 0000000..bf8dba3
--- /dev/null
+++ b/src/main/java/hotel/notifications/GovernanceNotifier.java
@@ -0,0 +1,42 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+public final class GovernanceNotifier implements Notifier {
+
+    private final String email;
+    private final EmailSender emailSender;
+
+    public GovernanceNotifier(String email, EmailSender emailSender) {
+        this.email = email;
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + room.number();
+        String body = formatConfirmationBody(reservation);
+        emailSender.send(email, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        String subject = "Reserva cancelada - quarto " + room.number();
+        String body = formatCancellationBody(reservation);
+        emailSender.send(email, subject, body);
+    }
+
+    private static String formatConfirmationBody(Reservation reservation) {
+        return "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests() + "\n";
+    }
+
+    private static String formatCancellationBody(Reservation reservation) {
+        return "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n";
+    }
+}
diff --git a/src/main/java/hotel/notifications/GuestNotifier.java b/src/main/java/hotel/notifications/GuestNotifier.java
new file mode 100644
index 0000000..4cfa530
