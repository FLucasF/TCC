diff --git a/src/main/java/hotel/notifications/FinanceNotifier.java b/src/main/java/hotel/notifications/FinanceNotifier.java
new file mode 100644
index 0000000..d1a06d4
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceNotifier.java
@@ -0,0 +1,40 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationEventListener;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** Notifies finance about payments and refunds. */
+public final class FinanceNotifier implements ReservationEventListener {
+
+    private static final String EMAIL = "financeiro@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public FinanceNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Pagamento recebido:\n\n"
+                + "Reserva: " + reservation.id() + "\n"
+                + "Valor: " + TextFormat.money(reservation.amountPaid()) + "\n";
+        emailSender.send(EMAIL, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        if (reservation.refund().compareTo(BigDecimal.ZERO) > 0) {
+            String subject = "Reembolso - reserva " + reservation.id();
+            String body = "Reembolso a processar:\n\n"
+                    + "Reserva: " + reservation.id() + "\n"
+                    + "Valor: " + TextFormat.money(reservation.refund()) + "\n";
+            emailSender.send(EMAIL, subject, body);
+        }
+    }
+}
diff --git a/src/main/java/hotel/notifications/HousekeepingNotifier.java b/src/main/java/hotel/notifications/HousekeepingNotifier.java
new file mode 100644
index 0000000..cae5f4c
--- /dev/null
+++ b/src/main/java/hotel/notifications/HousekeepingNotifier.java
@@ -0,0 +1,40 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationEventListener;
+import hotel.rooms.Room;
+
+/** Notifies housekeeping about confirmed and cancelled reservations. */
+public final class HousekeepingNotifier implements ReservationEventListener {
+
+    private static final String EMAIL = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public HousekeepingNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + room.number();
+        String body = "Nova reserva confirmada:\n\n"
+                + "Quarto: " + room.number() + "\n"
+                + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests() + "\n";
+        emailSender.send(EMAIL, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        String subject = "Reserva cancelada - quarto " + room.number();
+        String body = "Reserva cancelada:\n\n"
+                + "Quarto: " + room.number() + "\n"
+                + "Datas livres: " + TextFormat.date(reservation.checkIn())
+                + " a " + TextFormat.date(reservation.checkOut()) + "\n";
+        emailSender.send(EMAIL, subject, body);
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationEventListener.java b/src/main/java/hotel/reservations/ReservationEventListener.java
new file mode 100644
index 0000000..91e9c8b
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationEventListener.java
@@ -0,0 +1,13 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+
+/** Notified when something happens to a reservation. */
+public interface ReservationEventListener {
+
+    /** A reservation was confirmed: the guest paid. */
+    void onReservationConfirmed(Reservation reservation, Room room);
+
+    /** A confirmed reservation was cancelled. */
+    void onReservationCancelled(Reservation reservation, Room room);
+}
