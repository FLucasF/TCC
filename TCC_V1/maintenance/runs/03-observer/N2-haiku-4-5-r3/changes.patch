+
+    @Test
+    void cancellingAConfirmedReservationNotifiesListeners() {
+        TestReservationEventListener listener = new TestReservationEventListener();
+        service.addListener(listener);
+
+        Reservation reservation = service.create(stay(101, "2027-03-10", "2027-03-11", 1, RatePlan.STANDARD));
+        service.confirm(reservation.id());
+        listener.resetCalls();
+
+        service.cancel(reservation.id());
+
+        assertEquals(1, listener.cancelledReservations.size());
+        assertEquals(reservation.id(), listener.cancelledReservations.get(0).id());
+    }
+
+    @Test
+    void cancellingAPendingReservationDoesNotNotifyListeners() {
+        TestReservationEventListener listener = new TestReservationEventListener();
+        service.addListener(listener);
+
+        Reservation reservation = service.create(stay(101, "2027-03-10", "2027-03-11", 1, RatePlan.STANDARD));
+        service.cancel(reservation.id());
+
+        assertEquals(0, listener.cancelledReservations.size());
+    }
+
+    @Test
+    void confirmingAReservationNotifiesListeners() {
+        TestReservationEventListener listener = new TestReservationEventListener();
+        service.addListener(listener);
+
+        Reservation reservation = service.create(stay(101, "2027-03-10", "2027-03-11", 1, RatePlan.STANDARD));
+        service.confirm(reservation.id());
+
+        assertEquals(1, listener.confirmedReservations.size());
+        assertEquals(reservation.id(), listener.confirmedReservations.get(0).id());
+    }
+
+    private static class TestReservationEventListener implements hotel.reservations.ReservationEventListener {
+        final List<Reservation> confirmedReservations = new java.util.ArrayList<>();
+        final List<Reservation> cancelledReservations = new java.util.ArrayList<>();
+
+        @Override
+        public void onReservationConfirmed(Reservation reservation) {
+            confirmedReservations.add(reservation);
+        }
+
+        @Override
+        public void onReservationCancelled(Reservation reservation) {
+            cancelledReservations.add(reservation);
+        }
+
+        void resetCalls() {
+            confirmedReservations.clear();
+            cancelledReservations.clear();
+        }
+    }
 }
