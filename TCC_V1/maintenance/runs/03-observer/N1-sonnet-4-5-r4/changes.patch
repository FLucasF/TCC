diff --git a/src/main/java/hotel/reservations/FinanceNotifier.java b/src/main/java/hotel/reservations/FinanceNotifier.java
new file mode 100644
index 0000000..d543e40
--- /dev/null
+++ b/src/main/java/hotel/reservations/FinanceNotifier.java
@@ -0,0 +1,38 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** Notifies finance when payments are received or refunds are issued. */
+final class FinanceNotifier implements ReservationEventListener {
+
+    private final EmailSender emailSender;
+
+    FinanceNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                "financeiro@pousadamarealta.com.br",
+                "Pagamento recebido - reserva " + reservation.id(),
+                "Pagamento recebido:\n\n"
+                        + "Reserva: " + reservation.id() + "\n"
+                        + "Valor: " + TextFormat.money(reservation.amountPaid()) + "\n");
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room) {
+        if (reservation.refund() != null && reservation.refund().compareTo(BigDecimal.ZERO) > 0) {
+            emailSender.send(
+                    "financeiro@pousadamarealta.com.br",
+                    "Reembolso - reserva " + reservation.id(),
+                    "Reembolso a processar:\n\n"
+                            + "Reserva: " + reservation.id() + "\n"
+                            + "Valor: " + TextFormat.money(reservation.refund()) + "\n");
+        }
+    }
+}
diff --git a/src/main/java/hotel/reservations/GuestNotifier.java b/src/main/java/hotel/reservations/GuestNotifier.java
new file mode 100644
index 0000000..67f7b4b
--- /dev/null
+++ b/src/main/java/hotel/reservations/GuestNotifier.java
@@ -0,0 +1,32 @@
+package hotel.reservations;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+/** Sends reservation confirmation e-mails to the guest. */
+final class GuestNotifier implements ReservationEventListener {
+
+    private final EmailSender emailSender;
+
+    GuestNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + ReservationService.HOTEL_NAME,
+                "Olá, " + reservation.guest().name() + "!\n\n"
+                        + "Sua reserva na " + ReservationService.HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                        + receipt.text() + "\n"
+                        + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                        + "Até breve!\n");
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room) {
+    }
+}
diff --git a/src/main/java/hotel/reservations/HousekeepingNotifier.java b/src/main/java/hotel/reservations/HousekeepingNotifier.java
new file mode 100644
index 0000000..17148a6
--- /dev/null
+++ b/src/main/java/hotel/reservations/HousekeepingNotifier.java
@@ -0,0 +1,41 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+/** Notifies housekeeping when a reservation is confirmed or cancelled. */
+final class HousekeepingNotifier implements ReservationEventListener {
+
+    private final EmailSender emailSender;
+
+    HousekeepingNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                "governanca@pousadamarealta.com.br",
+                "Reserva confirmada - quarto " + reservation.roomNumber(),
+                "Nova reserva confirmada:\n\n"
+                        + "Quarto: " + reservation.roomNumber() + "\n"
+                        + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room) {
+        if (reservation.amountPaid().signum() > 0) {
+            emailSender.send(
+                    "governanca@pousadamarealta.com.br",
+                    "Reserva cancelada - quarto " + reservation.roomNumber(),
+                    "Reserva cancelada:\n\n"
+                            + "Quarto: " + reservation.roomNumber() + "\n"
+                            + "Datas que ficaram livres:\n"
+                            + "  De: " + TextFormat.date(reservation.checkIn()) + "\n"
+                            + "  Até: " + TextFormat.date(reservation.checkOut()) + "\n");
+        }
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationEventListener.java b/src/main/java/hotel/reservations/ReservationEventListener.java
new file mode 100644
index 0000000..096d0da
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationEventListener.java
@@ -0,0 +1,13 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+
+/** Receives notifications when something happens to a reservation. */
+public interface ReservationEventListener {
+
+    /** A pending reservation was paid and confirmed. */
+    void onConfirmed(Reservation reservation, Room room);
+
+    /** A reservation was cancelled. */
+    void onCancelled(Reservation reservation, Room room);
+}
