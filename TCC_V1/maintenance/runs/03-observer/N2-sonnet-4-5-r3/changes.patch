diff --git a/src/main/java/hotel/reservations/FinanceNotificationListener.java b/src/main/java/hotel/reservations/FinanceNotificationListener.java
new file mode 100644
index 0000000..fa33cda
--- /dev/null
+++ b/src/main/java/hotel/reservations/FinanceNotificationListener.java
@@ -0,0 +1,39 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** Notifies the finance department when a payment is received or a refund is due. */
+public final class FinanceNotificationListener implements ReservationEventListener {
+
+    private static final String FINANCE_EMAIL = "financeiro@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public FinanceNotificationListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Um pagamento foi recebido.\n\n"
+                + "Reserva: " + reservation.id() + "\n"
+                + "Valor pago: " + TextFormat.money(reservation.amountPaid()) + "\n";
+        emailSender.send(FINANCE_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room) {
+        BigDecimal refund = reservation.refund();
+        if (refund != null && refund.signum() > 0) {
+            String subject = "Reembolso - reserva " + reservation.id();
+            String body = "Um reembolso deve ser feito.\n\n"
+                    + "Reserva: " + reservation.id() + "\n"
+                    + "Valor a devolver: " + TextFormat.money(refund) + "\n";
+            emailSender.send(FINANCE_EMAIL, subject, body);
+        }
+    }
+}
diff --git a/src/main/java/hotel/reservations/GuestNotificationListener.java b/src/main/java/hotel/reservations/GuestNotificationListener.java
new file mode 100644
index 0000000..81f35d3
--- /dev/null
+++ b/src/main/java/hotel/reservations/GuestNotificationListener.java
@@ -0,0 +1,39 @@
+package hotel.reservations;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+/** Notifies the guest when their reservation is confirmed. */
+public final class GuestNotificationListener implements ReservationEventListener {
+
+    private static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final EmailSender emailSender;
+
+    public GuestNotificationListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                confirmationEmailBody(reservation, receipt));
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room) {
+        // the guest is not notified when their reservation is cancelled
+    }
+
+    private static String confirmationEmailBody(Reservation reservation, ReservationReceipt receipt) {
+        return "Olá, " + reservation.guest().name() + "!\n\n"
+                + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                + receipt.text() + "\n"
+                + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                + "Até breve!\n";
+    }
+}
