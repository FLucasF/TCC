diff --git a/src/main/java/hotel/notifications/FinanceNotice.java b/src/main/java/hotel/notifications/FinanceNotice.java
new file mode 100644
index 0000000..d27f2ad
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceNotice.java
@@ -0,0 +1,37 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/** Finance learns about payments received and refunds to be made. */
+final class FinanceNotice implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    FinanceNotice(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                address,
+                "Pagamento recebido - reserva " + reservation.id(),
+                "Valor pago: " + TextFormat.money(reservation.amountPaid()) + "\n");
+    }
+
+    @Override
+    public void cancelled(Reservation reservation, Room room, boolean wasConfirmed) {
+        if (!wasConfirmed || reservation.refund().signum() == 0) {
+            return;
+        }
+        emailSender.send(
+                address,
+                "Reembolso - reserva " + reservation.id(),
+                "Valor a devolver: " + TextFormat.money(reservation.refund()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/GuestNotice.java b/src/main/java/hotel/notifications/GuestNotice.java
new file mode 100644
index 0000000..f7d07d4
--- /dev/null
+++ b/src/main/java/hotel/notifications/GuestNotice.java
@@ -0,0 +1,31 @@
+package hotel.notifications;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/** The guest gets the receipt by e-mail when the reservation is confirmed. */
+final class GuestNotice implements ReservationListener {
+
+    static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final EmailSender emailSender;
+
+    GuestNotice(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                "Olá, " + reservation.guest().name() + "!\n\n"
+                        + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                        + receipt.text() + "\n"
+                        + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                        + "Até breve!\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/HousekeepingNotice.java b/src/main/java/hotel/notifications/HousekeepingNotice.java
new file mode 100644
index 0000000..b59971f
--- /dev/null
+++ b/src/main/java/hotel/notifications/HousekeepingNotice.java
@@ -0,0 +1,40 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/** Housekeeping learns when a room has to be prepared and when it is freed. */
+final class HousekeepingNotice implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    HousekeepingNotice(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                address,
+                "Reserva confirmada - quarto " + room.number(),
+                "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void cancelled(Reservation reservation, Room room, boolean wasConfirmed) {
+        if (!wasConfirmed) {
+            return;
+        }
+        emailSender.send(
+                address,
+                "Reserva cancelada - quarto " + room.number(),
+                "Datas liberadas: de " + TextFormat.date(reservation.checkIn())
+                        + " a " + TextFormat.date(reservation.checkOut()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/ReservationListener.java b/src/main/java/hotel/notifications/ReservationListener.java
new file mode 100644
index 0000000..fcd98fc
--- /dev/null
+++ b/src/main/java/hotel/notifications/ReservationListener.java
@@ -0,0 +1,16 @@
+package hotel.notifications;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/** Someone who wants to know what happens to reservations. Each one reacts only to what interests it. */
+public interface ReservationListener {
+
+    /** The guest paid and the reservation is now confirmed. */
+    default void confirmed(Reservation reservation, Room room) {
+    }
+
+    /** The reservation was cancelled; {@code wasConfirmed} tells whether it had been paid for. */
+    default void cancelled(Reservation reservation, Room room, boolean wasConfirmed) {
+    }
+}
diff --git a/src/main/java/hotel/notifications/ReservationListeners.java b/src/main/java/hotel/notifications/ReservationListeners.java
