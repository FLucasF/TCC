diff --git a/src/main/java/hotel/notifications/FinanceNotice.java b/src/main/java/hotel/notifications/FinanceNotice.java
new file mode 100644
index 0000000..1852a9f
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceNotice.java
@@ -0,0 +1,38 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Tells finance about payments received and refunds to give back. */
+public final class FinanceNotice implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    public FinanceNotice(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                address,
+                "Pagamento recebido - reserva " + reservation.id(),
+                "Valor pago: " + TextFormat.money(reservation.amountPaid()) + "\n");
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room, boolean wasConfirmed) {
+        if (!wasConfirmed || reservation.refund().signum() <= 0) {
+            return;
+        }
+        emailSender.send(
+                address,
+                "Reembolso - reserva " + reservation.id(),
+                "Valor a devolver: " + TextFormat.money(reservation.refund()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/GuestConfirmationEmail.java b/src/main/java/hotel/notifications/GuestConfirmationEmail.java
new file mode 100644
index 0000000..21648a5
--- /dev/null
+++ b/src/main/java/hotel/notifications/GuestConfirmationEmail.java
@@ -0,0 +1,32 @@
+package hotel.notifications;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Sends the guest the receipt when the reservation is confirmed. */
+public final class GuestConfirmationEmail implements ReservationListener {
+
+    private static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final EmailSender emailSender;
+
+    public GuestConfirmationEmail(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                "Olá, " + reservation.guest().name() + "!\n\n"
+                        + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                        + receipt.text() + "\n"
+                        + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                        + "Até breve!\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/HousekeepingNotice.java b/src/main/java/hotel/notifications/HousekeepingNotice.java
new file mode 100644
index 0000000..0627897
--- /dev/null
+++ b/src/main/java/hotel/notifications/HousekeepingNotice.java
@@ -0,0 +1,41 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Tells housekeeping when a room must be prepared and when its dates are freed. */
+public final class HousekeepingNotice implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    public HousekeepingNotice(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                address,
+                "Reserva confirmada - quarto " + room.number(),
+                "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room, boolean wasConfirmed) {
+        if (!wasConfirmed) {
+            return;
+        }
+        emailSender.send(
+                address,
+                "Reserva cancelada - quarto " + room.number(),
+                "Datas liberadas: de " + TextFormat.date(reservation.checkIn())
+                        + " a " + TextFormat.date(reservation.checkOut()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationListener.java b/src/main/java/hotel/reservations/ReservationListener.java
new file mode 100644
index 0000000..ef41fa6
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationListener.java
@@ -0,0 +1,15 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+
+/** Reacts to what happens to a reservation. Each listener acts only on the events it cares about. */
+public interface ReservationListener {
+
+    /** The guest paid and the reservation was confirmed. */
+    default void onConfirmed(Reservation reservation, Room room) {
+    }
+
+    /** The reservation was cancelled; {@code wasConfirmed} tells whether it had been paid before. */
+    default void onCancelled(Reservation reservation, Room room, boolean wasConfirmed) {
+    }
+}
