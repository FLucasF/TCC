diff --git a/src/main/java/hotel/reservations/notifications/FinanceNotifier.java b/src/main/java/hotel/reservations/notifications/FinanceNotifier.java
new file mode 100644
index 0000000..38055b8
--- /dev/null
+++ b/src/main/java/hotel/reservations/notifications/FinanceNotifier.java
@@ -0,0 +1,35 @@
+package hotel.reservations.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationStatus;
+import hotel.rooms.Room;
+
+class FinanceNotifier implements ReservationEventNotifier {
+    private final EmailSender emailSender;
+    private final String financeEmail;
+
+    FinanceNotifier(EmailSender emailSender, String financeEmail) {
+        this.emailSender = emailSender;
+        this.financeEmail = financeEmail;
+    }
+
+    @Override
+    public void notifyConfirmation(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.amountPaid());
+        emailSender.send(financeEmail, subject, body);
+    }
+
+    @Override
+    public void notifyCancellation(Reservation reservation, Room room) {
+        if (reservation.status() != ReservationStatus.CANCELLED || reservation.refund() == null
+                || reservation.refund().signum() == 0) {
+            return;
+        }
+        String subject = "Reembolso - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.refund());
+        emailSender.send(financeEmail, subject, body);
+    }
+}
diff --git a/src/main/java/hotel/reservations/notifications/HousekeepingNotifier.java b/src/main/java/hotel/reservations/notifications/HousekeepingNotifier.java
new file mode 100644
index 0000000..8ff93d4
--- /dev/null
+++ b/src/main/java/hotel/reservations/notifications/HousekeepingNotifier.java
@@ -0,0 +1,39 @@
+package hotel.reservations.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationStatus;
+import hotel.rooms.Room;
+
+class HousekeepingNotifier implements ReservationEventNotifier {
+    private final EmailSender emailSender;
+    private final String housekeepingEmail;
+
+    HousekeepingNotifier(EmailSender emailSender, String housekeepingEmail) {
+        this.emailSender = emailSender;
+        this.housekeepingEmail = housekeepingEmail;
+    }
+
+    @Override
+    public void notifyConfirmation(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + reservation.roomNumber();
+        String body = "Quarto " + reservation.roomNumber() + "\n"
+                + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests();
+        emailSender.send(housekeepingEmail, subject, body);
+    }
+
+    @Override
+    public void notifyCancellation(Reservation reservation, Room room) {
+        if (reservation.status() != ReservationStatus.CANCELLED) {
+            return;
+        }
+        String subject = "Reserva cancelada - quarto " + reservation.roomNumber();
+        String body = "Quarto " + reservation.roomNumber() + "\n"
+                + "Datas liberadas: " + TextFormat.date(reservation.checkIn()) + " a "
+                + TextFormat.date(reservation.checkOut());
+        emailSender.send(housekeepingEmail, subject, body);
+    }
+}
diff --git a/src/main/java/hotel/reservations/notifications/ReservationEventNotifier.java b/src/main/java/hotel/reservations/notifications/ReservationEventNotifier.java
