+++ b/src/main/java/hotel/reservations/GovernanceNotifier.java
@@ -0,0 +1,32 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+
+public final class GovernanceNotifier implements ReservationNotifier {
+
+    private static final String GOVERNANCE_EMAIL = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public GovernanceNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmation(Reservation reservation) {
+        String subject = "Reserva confirmada - quarto " + reservation.roomNumber();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests();
+        emailSender.send(GOVERNANCE_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onCancellation(Reservation reservation) {
+        String subject = "Reserva cancelada - quarto " + reservation.roomNumber();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut());
+        emailSender.send(GOVERNANCE_EMAIL, subject, body);
+    }
+}
diff --git a/src/main/java/hotel/reservations/GuestNotifier.java b/src/main/java/hotel/reservations/GuestNotifier.java
new file mode 100644
index 0000000..299e9ad
--- /dev/null
+++ b/src/main/java/hotel/reservations/GuestNotifier.java
@@ -0,0 +1,45 @@
+package hotel.reservations;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+import hotel.rooms.Rooms;
+
+public final class GuestNotifier implements ReservationNotifier {
+
+    private static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final Rooms rooms;
+    private final EmailSender emailSender;
+
+    public GuestNotifier(Rooms rooms, EmailSender emailSender) {
+        this.rooms = rooms;
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmation(Reservation reservation) {
+        Room room = roomOf(reservation);
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                confirmationEmailBody(reservation, receipt));
+    }
+
+    @Override
+    public void onCancellation(Reservation reservation) {
+    }
+
+    private Room roomOf(Reservation reservation) {
+        return rooms.find(reservation.roomNumber()).orElseThrow();
+    }
+
+    private static String confirmationEmailBody(Reservation reservation, ReservationReceipt receipt) {
+        return "Olá, " + reservation.guest().name() + "!\n\n"
+                + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                + receipt.text() + "\n"
+                + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                + "Até breve!\n";
+    }
+}
