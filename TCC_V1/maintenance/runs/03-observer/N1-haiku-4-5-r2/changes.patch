+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+public final class GovernanceListener implements ReservationEventListener {
+
+    private final EmailSender emailSender;
+
+    public GovernanceListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + reservation.roomNumber();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests();
+        emailSender.send("governanca@pousadamarealta.com.br", subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+        String subject = "Reserva cancelada - quarto " + reservation.roomNumber();
+        String body = "Entrada (liberada): " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída (liberada): " + TextFormat.date(reservation.checkOut());
+        emailSender.send("governanca@pousadamarealta.com.br", subject, body);
+    }
+}
diff --git a/src/main/java/hotel/notifications/GuestConfirmationListener.java b/src/main/java/hotel/notifications/GuestConfirmationListener.java
new file mode 100644
index 0000000..93d21c9
--- /dev/null
+++ b/src/main/java/hotel/notifications/GuestConfirmationListener.java
@@ -0,0 +1,37 @@
+package hotel.notifications;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+public final class GuestConfirmationListener implements ReservationEventListener {
+
+    static final String HOTEL_NAME = "Pousada Maré Alta";
+    private final EmailSender emailSender;
+
+    public GuestConfirmationListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                confirmationEmailBody(reservation, receipt));
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room) {
+    }
+
+    private static String confirmationEmailBody(Reservation reservation, ReservationReceipt receipt) {
+        return "Olá, " + reservation.guest().name() + "!\n\n"
+                + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                + receipt.text() + "\n"
+                + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                + "Até breve!\n";
+    }
+}
