new file mode 100644
index 0000000..708b6e0
--- /dev/null
+++ b/src/main/java/hotel/reservations/FinanceListener.java
@@ -0,0 +1,36 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import java.math.BigDecimal;
+
+/** Notifies the finance department of confirmed reservations and refunds. */
+public final class FinanceListener implements ReservationEventListener {
+
+    private static final String FINANCE_EMAIL = "financeiro@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public FinanceListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(ReservationConfirmedEvent event) {
+        Reservation reservation = event.reservation();
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.amountPaid());
+        emailSender.send(FINANCE_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(ReservationCancelledEvent event) {
+        Reservation reservation = event.reservation();
+        BigDecimal refund = event.refund();
+        if (refund.signum() > 0) {
+            String subject = "Reembolso - reserva " + reservation.id();
+            String body = "Valor: " + TextFormat.money(refund);
+            emailSender.send(FINANCE_EMAIL, subject, body);
+        }
+    }
+}
diff --git a/src/main/java/hotel/reservations/GovernanceListener.java b/src/main/java/hotel/reservations/GovernanceListener.java
new file mode 100644
index 0000000..c35e3f0
--- /dev/null
+++ b/src/main/java/hotel/reservations/GovernanceListener.java
@@ -0,0 +1,45 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+
+/** Notifies the housekeeping department of confirmed and cancelled reservations. */
+public final class GovernanceListener implements ReservationEventListener {
+
+    private static final String GOVERNANCE_EMAIL = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public GovernanceListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(ReservationConfirmedEvent event) {
+        Reservation reservation = event.reservation();
+        String subject = "Reserva confirmada - quarto " + reservation.roomNumber();
+        String body = buildConfirmationBody(event);
+        emailSender.send(GOVERNANCE_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onReservationCancelled(ReservationCancelledEvent event) {
+        Reservation reservation = event.reservation();
+        String subject = "Reserva cancelada - quarto " + reservation.roomNumber();
+        String body = buildCancellationBody(event);
+        emailSender.send(GOVERNANCE_EMAIL, subject, body);
+    }
+
+    private String buildConfirmationBody(ReservationConfirmedEvent event) {
+        Reservation reservation = event.reservation();
+        return "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests();
+    }
+
+    private String buildCancellationBody(ReservationCancelledEvent event) {
+        Reservation reservation = event.reservation();
+        return "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut());
+    }
+}
