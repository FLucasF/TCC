diff --git a/src/main/java/hotel/notifications/FinanceNotifier.java b/src/main/java/hotel/notifications/FinanceNotifier.java
new file mode 100644
index 0000000..77827ce
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceNotifier.java
@@ -0,0 +1,38 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Tells the finance team about payments received and refunds to pay. */
+public final class FinanceNotifier implements ReservationListener {
+
+    static final String ADDRESS = "financeiro@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public FinanceNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                ADDRESS,
+                "Pagamento recebido - reserva " + reservation.id(),
+                "Valor pago: " + TextFormat.money(reservation.amountPaid()) + "\n");
+    }
+
+    @Override
+    public void confirmedReservationCancelled(Reservation reservation, Room room) {
+        if (reservation.refund().signum() == 0) {
+            return;
+        }
+        emailSender.send(
+                ADDRESS,
+                "Reembolso - reserva " + reservation.id(),
+                "Valor a devolver: " + TextFormat.money(reservation.refund()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/GuestNotifier.java b/src/main/java/hotel/notifications/GuestNotifier.java
new file mode 100644
index 0000000..0c8f236
--- /dev/null
+++ b/src/main/java/hotel/notifications/GuestNotifier.java
@@ -0,0 +1,32 @@
+package hotel.notifications;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Sends the guest the receipt when the reservation is confirmed. */
+public final class GuestNotifier implements ReservationListener {
+
+    static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final EmailSender emailSender;
+
+    public GuestNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                "Olá, " + reservation.guest().name() + "!\n\n"
+                        + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                        + receipt.text() + "\n"
+                        + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                        + "Até breve!\n");
+    }
+}
