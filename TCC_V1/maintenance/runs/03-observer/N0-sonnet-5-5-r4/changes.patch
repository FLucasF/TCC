@@ -0,0 +1,16 @@
+package hotel.notifications;
+
+import hotel.messages.EmailSender;
+import hotel.reservations.ReservationListener;
+import java.util.List;
+
+/** The staff who are told about reservations. To add or remove someone, change this list. */
+public final class StaffNotifications {
+
+    private StaffNotifications() {
+    }
+
+    public static List<ReservationListener> all(EmailSender emailSender) {
+        return List.of(new GovernanceNotifier(emailSender), new FinanceNotifier(emailSender));
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationListener.java b/src/main/java/hotel/reservations/ReservationListener.java
new file mode 100644
index 0000000..1ee67e2
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationListener.java
@@ -0,0 +1,26 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/**
+ * Someone who wants to know when something happens to a reservation. Register one in the
+ * {@link ReservationService} to be told; override only the events you care about.
+ */
+public interface ReservationListener {
+
+    /** The guest paid and the reservation is now confirmed. */
+    default void onConfirmed(Confirmed event) {
+    }
+
+    /** A reservation was cancelled. */
+    default void onCancelled(Cancelled event) {
+    }
+
+    record Confirmed(Reservation reservation, Room room) {
+    }
+
+    /** {@code wasConfirmed} tells whether it had been paid and confirmed before the cancellation. */
+    record Cancelled(Reservation reservation, Room room, boolean wasConfirmed, BigDecimal refund) {
+    }
+}
