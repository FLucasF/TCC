diff --git a/src/main/java/hotel/notifications/DepartmentNotifications.java b/src/main/java/hotel/notifications/DepartmentNotifications.java
new file mode 100644
index 0000000..29216e8
--- /dev/null
+++ b/src/main/java/hotel/notifications/DepartmentNotifications.java
@@ -0,0 +1,17 @@
+package hotel.notifications;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/**
+ * A department that wants to be notified about reservation events. Each department decides which
+ * events matter and how to handle them.
+ */
+public interface DepartmentNotifications {
+
+    /** Called when a reservation is confirmed (the guest paid). */
+    void onConfirmation(Reservation reservation, Room room);
+
+    /** Called when a confirmed reservation is cancelled. */
+    void onCancellation(Reservation reservation, Room room);
+}
diff --git a/src/main/java/hotel/notifications/FinanceNotifications.java b/src/main/java/hotel/notifications/FinanceNotifications.java
new file mode 100644
index 0000000..411b9f5
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceNotifications.java
@@ -0,0 +1,41 @@
+package hotel.notifications;
+
+import static hotel.documents.TextFormat.money;
+
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** Notifications for the finance team: payments received and refunds to issue. */
+public final class FinanceNotifications implements DepartmentNotifications {
+
+    private static final String EMAIL = "financeiro@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public FinanceNotifications(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmation(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Pagamento recebido.\n\n"
+                + "Reserva: " + reservation.id() + "\n"
+                + "Valor pago: " + money(reservation.amountPaid()) + "\n";
+        emailSender.send(EMAIL, subject, body);
+    }
+
+    @Override
+    public void onCancellation(Reservation reservation, Room room) {
+        BigDecimal refund = reservation.refund();
+        if (refund != null && refund.compareTo(BigDecimal.ZERO) > 0) {
+            String subject = "Reembolso - reserva " + reservation.id();
+            String body = "Reembolso a processar.\n\n"
+                    + "Reserva: " + reservation.id() + "\n"
+                    + "Valor a devolver: " + money(refund) + "\n";
+            emailSender.send(EMAIL, subject, body);
+        }
+    }
+}
