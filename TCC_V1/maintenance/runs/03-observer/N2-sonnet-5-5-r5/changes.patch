+++ b/src/main/java/hotel/notifications/GuestNotice.java
@@ -0,0 +1,32 @@
+package hotel.notifications;
+
+import hotel.documents.ReservationReceipt;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+/** Sends the guest the receipt when the reservation is confirmed. */
+public final class GuestNotice implements ReservationListener {
+
+    static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final EmailSender emailSender;
+
+    public GuestNotice(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                "Olá, " + reservation.guest().name() + "!\n\n"
+                        + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                        + receipt.text() + "\n"
+                        + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                        + "Até breve!\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/HousekeepingNotice.java b/src/main/java/hotel/notifications/HousekeepingNotice.java
new file mode 100644
index 0000000..59c736e
--- /dev/null
+++ b/src/main/java/hotel/notifications/HousekeepingNotice.java
@@ -0,0 +1,42 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.reservations.ReservationStatus;
+import hotel.rooms.Room;
+
+/** Tells housekeeping which room to prepare, and when a confirmed room is freed. */
+public final class HousekeepingNotice implements ReservationListener {
+
+    static final String ADDRESS = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public HousekeepingNotice(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                ADDRESS,
+                "Reserva confirmada - quarto " + room.number(),
+                "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void cancelled(Reservation reservation, Room room, ReservationStatus statusBefore) {
+        if (statusBefore != ReservationStatus.CONFIRMED) {
+            return;
+        }
+        emailSender.send(
+                ADDRESS,
+                "Reserva cancelada - quarto " + room.number(),
+                "Datas liberadas: de " + TextFormat.date(reservation.checkIn())
+                        + " a " + TextFormat.date(reservation.checkOut()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationListener.java b/src/main/java/hotel/reservations/ReservationListener.java
new file mode 100644
index 0000000..d6f943d
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationListener.java
@@ -0,0 +1,15 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+
+/** Someone who reacts to what happens to a reservation. Each listener decides which events matter to it. */
+public interface ReservationListener {
+
+    /** The guest paid and the reservation is now confirmed. */
+    default void confirmed(Reservation reservation, Room room) {
+    }
+
+    /** The reservation was cancelled; {@code statusBefore} tells whether it had been confirmed. */
+    default void cancelled(Reservation reservation, Room room, ReservationStatus statusBefore) {
+    }
+}
