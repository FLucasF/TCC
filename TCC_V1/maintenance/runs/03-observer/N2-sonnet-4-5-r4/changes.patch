diff --git a/src/main/java/hotel/reservations/listeners/FinanceListener.java b/src/main/java/hotel/reservations/listeners/FinanceListener.java
new file mode 100644
index 0000000..0ab8afa
--- /dev/null
+++ b/src/main/java/hotel/reservations/listeners/FinanceListener.java
@@ -0,0 +1,35 @@
+package hotel.reservations.listeners;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+public final class FinanceListener implements ReservationListener {
+
+    private final EmailSender emailSender;
+
+    public FinanceListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                "financeiro@pousadamarealta.com.br",
+                "Pagamento recebido - reserva " + reservation.id(),
+                "Valor: " + TextFormat.money(reservation.amountPaid()) + "\n");
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room, boolean wasPreviouslyConfirmed) {
+        if (wasPreviouslyConfirmed && reservation.refund().signum() > 0) {
+            emailSender.send(
+                    "financeiro@pousadamarealta.com.br",
+                    "Reembolso - reserva " + reservation.id(),
+                    "Valor: " + TextFormat.money(reservation.refund()) + "\n");
+        }
+    }
+}
diff --git a/src/main/java/hotel/reservations/listeners/GuestNotificationListener.java b/src/main/java/hotel/reservations/listeners/GuestNotificationListener.java
new file mode 100644
index 0000000..d90bac7
--- /dev/null
+++ b/src/main/java/hotel/reservations/listeners/GuestNotificationListener.java
@@ -0,0 +1,39 @@
+package hotel.reservations.listeners;
+
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+import hotel.documents.ReservationReceipt;
+
+public final class GuestNotificationListener implements ReservationListener {
+
+    private static final String HOTEL_NAME = "Pousada Maré Alta";
+
+    private final EmailSender emailSender;
+
+    public GuestNotificationListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+        emailSender.send(
+                reservation.guest().email(),
+                "Reserva confirmada - " + HOTEL_NAME,
+                confirmationEmailBody(reservation, receipt));
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room, boolean wasPreviouslyConfirmed) {
+    }
+
+    private static String confirmationEmailBody(Reservation reservation, ReservationReceipt receipt) {
+        return "Olá, " + reservation.guest().name() + "!\n\n"
+                + "Sua reserva na " + HOTEL_NAME + " está confirmada. Estes são os dados dela:\n\n"
+                + receipt.text() + "\n"
+                + "A entrada é a partir das 14h, e a saída, até as 12h.\n"
+                + "Até breve!\n";
+    }
+}
diff --git a/src/main/java/hotel/reservations/listeners/HousekeepingListener.java b/src/main/java/hotel/reservations/listeners/HousekeepingListener.java
new file mode 100644
index 0000000..5d045fa
--- /dev/null
+++ b/src/main/java/hotel/reservations/listeners/HousekeepingListener.java
@@ -0,0 +1,37 @@
+package hotel.reservations.listeners;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationListener;
+import hotel.rooms.Room;
+
+public final class HousekeepingListener implements ReservationListener {
+
+    private final EmailSender emailSender;
+
+    public HousekeepingListener(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onReservationConfirmed(Reservation reservation, Room room) {
+        emailSender.send(
+                "governanca@pousadamarealta.com.br",
+                "Reserva confirmada - quarto " + room.number(),
+                "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void onReservationCancelled(Reservation reservation, Room room, boolean wasPreviouslyConfirmed) {
+        if (wasPreviouslyConfirmed) {
+            emailSender.send(
+                    "governanca@pousadamarealta.com.br",
+                    "Reserva cancelada - quarto " + room.number(),
+                    "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                            + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n");
+        }
+    }
+}
