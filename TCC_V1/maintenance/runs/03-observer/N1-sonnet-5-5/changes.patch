@@ -0,0 +1,36 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+
+/** Tells housekeeping when a room has to be prepared, and when it is free again. */
+public final class HousekeepingNotices implements ReservationListener {
+
+    private final EmailSender emailSender;
+    private final String address;
+
+    public HousekeepingNotices(EmailSender emailSender, String address) {
+        this.emailSender = emailSender;
+        this.address = address;
+    }
+
+    @Override
+    public void confirmed(Reservation reservation) {
+        emailSender.send(
+                address,
+                "Reserva confirmada - quarto " + reservation.roomNumber(),
+                "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                        + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                        + "Hóspedes: " + reservation.guests() + "\n");
+    }
+
+    @Override
+    public void cancelledAfterConfirmation(Reservation reservation) {
+        emailSender.send(
+                address,
+                "Reserva cancelada - quarto " + reservation.roomNumber(),
+                "Datas que ficaram livres: " + TextFormat.date(reservation.checkIn())
+                        + " a " + TextFormat.date(reservation.checkOut()) + "\n");
+    }
+}
diff --git a/src/main/java/hotel/notifications/ReservationListener.java b/src/main/java/hotel/notifications/ReservationListener.java
new file mode 100644
index 0000000..132cf76
--- /dev/null
+++ b/src/main/java/hotel/notifications/ReservationListener.java
@@ -0,0 +1,18 @@
+package hotel.notifications;
+
+import hotel.reservations.Reservation;
+
+/**
+ * Someone who wants to know what happens to reservations. Each listener picks the events it cares about; a new
+ * party to notify is a new listener, plugged in where the inn is put together.
+ */
+public interface ReservationListener {
+
+    /** The guest paid and the reservation is now confirmed. */
+    default void confirmed(Reservation reservation) {
+    }
+
+    /** A reservation that was already confirmed has been cancelled (its refund is set). */
+    default void cancelledAfterConfirmation(Reservation reservation) {
+    }
+}
