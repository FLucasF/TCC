diff --git a/src/main/resources/db/migration/V2__guest_identification.sql b/src/main/resources/db/migration/V2__guest_identification.sql
new file mode 100644
index 0000000..cd11ccf
--- /dev/null
+++ b/src/main/resources/db/migration/V2__guest_identification.sql
@@ -0,0 +1,14 @@
+-- A guest is identified by a CPF, or is a company's employee (CNPJ + company name), or a foreigner (passport + country).
+ALTER TABLE reservations
+    ALTER COLUMN guest_cpf DROP NOT NULL,
+    ADD COLUMN guest_cnpj     text,
+    ADD COLUMN company_name   text,
+    ADD COLUMN guest_passport text,
+    ADD COLUMN guest_country  text,
+    ADD CONSTRAINT reservations_one_identification CHECK (
+        (guest_cpf IS NOT NULL AND guest_cnpj IS NULL AND company_name IS NULL
+            AND guest_passport IS NULL AND guest_country IS NULL)
+        OR (guest_cpf IS NULL AND guest_cnpj IS NOT NULL AND company_name IS NOT NULL
+            AND guest_passport IS NULL AND guest_country IS NULL)
+        OR (guest_cpf IS NULL AND guest_cnpj IS NULL AND company_name IS NULL
+            AND guest_passport IS NOT NULL AND guest_country IS NOT NULL));
