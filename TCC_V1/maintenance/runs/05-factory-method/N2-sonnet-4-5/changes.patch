diff --git a/src/main/java/hotel/documents/EnglishFormat.java b/src/main/java/hotel/documents/EnglishFormat.java
new file mode 100644
index 0000000..b9ff35f
--- /dev/null
+++ b/src/main/java/hotel/documents/EnglishFormat.java
@@ -0,0 +1,24 @@
+package hotel.documents;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.format.DateTimeFormatter;
+import java.util.Locale;
+
+/** How money and dates are written in English for international guests. */
+public final class EnglishFormat {
+
+    private static final Locale US = Locale.US;
+    private static final DateTimeFormatter ISO_DATE = DateTimeFormatter.ISO_LOCAL_DATE;
+
+    private EnglishFormat() {
+    }
+
+    public static String money(BigDecimal amount) {
+        return "BRL " + String.format(US, "%,.2f", amount);
+    }
+
+    public static String date(LocalDate date) {
+        return ISO_DATE.format(date);
+    }
+}
