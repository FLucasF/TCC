diff --git a/src/main/resources/db/migration/V2__add_guest_types.sql b/src/main/resources/db/migration/V2__add_guest_types.sql
new file mode 100644
index 0000000..600dd95
--- /dev/null
+++ b/src/main/resources/db/migration/V2__add_guest_types.sql
@@ -0,0 +1,18 @@
+-- Adds the new guest identification fields: company (CNPJ + name) and foreign guest (passport + country).
+-- The guest_cpf is no longer mandatory: a reservation has exactly one of the three identification types.
+
+ALTER TABLE reservations
+    ALTER COLUMN guest_cpf DROP NOT NULL,
+    ADD COLUMN company_cnpj text,
+    ADD COLUMN company_name text,
+    ADD COLUMN guest_passport text,
+    ADD COLUMN guest_country text,
+    ADD CONSTRAINT reservations_one_guest_type
+        CHECK (
+            (guest_cpf IS NOT NULL AND company_cnpj IS NULL AND company_name IS NULL
+                AND guest_passport IS NULL AND guest_country IS NULL)
+            OR (guest_cpf IS NULL AND company_cnpj IS NOT NULL AND company_name IS NOT NULL
+                AND guest_passport IS NULL AND guest_country IS NULL)
+            OR (guest_cpf IS NULL AND company_cnpj IS NULL AND company_name IS NULL
+                AND guest_passport IS NOT NULL AND guest_country IS NOT NULL)
+        );
