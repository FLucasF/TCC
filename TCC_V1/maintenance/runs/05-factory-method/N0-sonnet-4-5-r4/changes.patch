@@ -0,0 +1,67 @@
+package hotel.documents;
+
+import hotel.reservations.PriceCalculator;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import hotel.rooms.RoomType;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** Invoice for company reservations. */
+public record InvoiceDocument(
+        String title,
+        long reservationId,
+        String guestName,
+        String guestCpf,
+        String companyCnpj,
+        String companyName,
+        String guestPassport,
+        String guestCountry,
+        int roomNumber,
+        RoomType roomType,
+        LocalDate checkIn,
+        LocalDate checkOut,
+        int nights,
+        BigDecimal subtotal,
+        BigDecimal discount,
+        BigDecimal total) implements ReservationDocument {
+
+    public InvoiceDocument(Reservation reservation, Room room) {
+        this(
+                "Fatura de hospedagem",
+                reservation.id(),
+                reservation.guest().name(),
+                null,
+                reservation.guest().companyCnpj(),
+                reservation.guest().companyName(),
+                null,
+                null,
+                room.number(),
+                room.type(),
+                reservation.checkIn(),
+                reservation.checkOut(),
+                reservation.price().nights(),
+                reservation.price().subtotal(),
+                reservation.price().discount(),
+                reservation.price().total());
+    }
+
+    public String text() {
+        StringBuilder text = new StringBuilder();
+        text.append(title).append(" nº ").append(reservationId).append('\n');
+        text.append("Empresa: ").append(companyName).append(" (CNPJ ").append(companyCnpj).append(")\n");
+        text.append("Hóspede: ").append(guestName).append('\n');
+        text.append("Quarto: ").append(roomNumber).append(" (").append(roomType).append(")\n");
+        text.append("Entrada: ").append(TextFormat.date(checkIn))
+                .append(" | Saída: ").append(TextFormat.date(checkOut))
+                .append(" | ").append(nights).append(nights == 1 ? " diária" : " diárias").append('\n');
+        text.append("Diárias: ").append(TextFormat.money(subtotal)).append('\n');
+        if (discount.signum() > 0) {
+            text.append("Desconto: ").append(TextFormat.money(discount)).append('\n');
+        }
+        text.append("Total: ").append(TextFormat.money(total)).append('\n');
+        BigDecimal iss = PriceCalculator.cents(total.multiply(new BigDecimal("0.05")));
+        text.append("ISS retido (5%): ").append(TextFormat.money(iss)).append('\n');
+        return text.toString();
+    }
+}
diff --git a/src/main/java/hotel/documents/ReservationDocument.java b/src/main/java/hotel/documents/ReservationDocument.java
new file mode 100644
index 0000000..2c921ef
--- /dev/null
+++ b/src/main/java/hotel/documents/ReservationDocument.java
@@ -0,0 +1,53 @@
+package hotel.documents;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import hotel.rooms.RoomType;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** Base interface for all reservation documents (receipt, invoice, booking receipt). */
+public interface ReservationDocument {
+
+    String title();
+
+    long reservationId();
+
+    String guestName();
+
+    String guestCpf();
+
+    String companyCnpj();
+
+    String companyName();
+
+    String guestPassport();
+
+    String guestCountry();
+
+    int roomNumber();
+
+    RoomType roomType();
+
+    LocalDate checkIn();
+
+    LocalDate checkOut();
+
+    int nights();
+
+    BigDecimal subtotal();
+
+    BigDecimal discount();
+
+    BigDecimal total();
+
+    String text();
+
+    static ReservationDocument create(Reservation reservation, Room room) {
+        return switch (reservation.guest().type()) {
+            case INDIVIDUAL -> new ReservationReceipt(reservation, room);
+            case COMPANY -> new InvoiceDocument(reservation, room);
+            case FOREIGNER -> new BookingReceiptDocument(reservation, room);
+        };
+    }
+}
