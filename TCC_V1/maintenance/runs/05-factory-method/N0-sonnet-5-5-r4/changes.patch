+        HttpResponse<String> foreigner = post("/reservations", reservationWith(
+                "\"guestPassport\": \"X1234567\", \"guestCountry\": \"United Kingdom\",").replace("201", "202"));
+        assertEquals(201, foreigner.statusCode());
+        long id = json.readTree(foreigner.body()).get("id").asLong();
+        post("/reservations/" + id + "/confirmation", "");
+        JsonNode document = json.readTree(get("/reservations/" + id + "/document").body());
+        assertEquals("Booking receipt", document.get("title").asText());
