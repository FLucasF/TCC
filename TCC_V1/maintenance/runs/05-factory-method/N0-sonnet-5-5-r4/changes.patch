+    @Test
+    void acceptsACompanyOrAForeignGuestAndNullsTheRest() throws Exception {
+        HttpResponse<String> company = post("/reservations",
+                reservationWith("\"companyCnpj\": \"12.345.678/0001-90\", \"companyName\": \"Tecnosul Ltda\","));
+        assertEquals(201, company.statusCode());
+        JsonNode created = json.readTree(company.body());
+        assertEquals("Tecnosul Ltda", created.get("companyName").asText());
+        assertTrue(created.get("guestCpf").isNull());
+        assertTrue(created.get("guestPassport").isNull());
