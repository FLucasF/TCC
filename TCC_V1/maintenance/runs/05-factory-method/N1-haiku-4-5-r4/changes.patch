+            throw new HotelException(ErrorCode.INVALID_REQUEST, "guestCountry is required when guestPassport is provided");
+        }
+        if (!isBlank(body.guestCountry()) && isBlank(body.guestPassport())) {
+            throw new HotelException(ErrorCode.INVALID_REQUEST, "guestPassport is required when guestCountry is provided");
+        }
+
+        Guest guest = new Guest(
+                body.guestName(),
+                body.guestEmail(),
+                body.guestCpf(),
+                body.companyCnpj(),
+                body.companyName(),
+                body.guestPassport(),
+                body.guestCountry());
         return new NewReservation(
                 body.roomNumber(), guest, body.checkIn(), body.checkOut(), body.guests(), body.ratePlan());
     }
