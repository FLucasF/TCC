@@ -0,0 +1,49 @@
+package hotel.documents;
+
+import hotel.reservations.IdentificationFields;
+import hotel.reservations.Price;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/** The receipt for a foreign guest with a passport, in English. */
+public final class BookingReceiptLayout extends DocumentLayout {
+
+    @Override
+    protected String title() {
+        return "Booking receipt";
+    }
+
+    @Override
+    protected String headerLine(long reservationId) {
+        return title() + " no. " + reservationId + "\n";
+    }
+
+    @Override
+    protected String identityLines(Reservation reservation) {
+        IdentificationFields guest = reservation.guest().identification().fields();
+        return "Guest: " + reservation.guest().name()
+                + " (passport " + guest.guestPassport() + ", " + guest.guestCountry() + ")\n";
+    }
+
+    @Override
+    protected String roomLine(Room room) {
+        return "Room: " + room.number() + " (" + room.type() + ")\n";
+    }
+
+    @Override
+    protected String stayLine(Reservation reservation) {
+        int nights = reservation.price().nights();
+        return "Check-in: " + TextFormat.englishDate(reservation.checkIn())
+                + " | Check-out: " + TextFormat.englishDate(reservation.checkOut())
+                + " | " + nights + (nights == 1 ? " night" : " nights") + "\n";
+    }
+
+    @Override
+    protected String priceLines(Price price) {
+        String lines = "Nights: " + TextFormat.englishMoney(price.subtotal()) + "\n";
+        if (price.discount().signum() > 0) {
+            lines += "Discount: " + TextFormat.englishMoney(price.discount()) + "\n";
+        }
+        return lines + "Total: " + TextFormat.englishMoney(price.total()) + "\n";
+    }
+}
diff --git a/src/main/java/hotel/documents/DocumentLayout.java b/src/main/java/hotel/documents/DocumentLayout.java
new file mode 100644
index 0000000..c3fdb72
--- /dev/null
+++ b/src/main/java/hotel/documents/DocumentLayout.java
@@ -0,0 +1,65 @@
+package hotel.documents;
+
+import hotel.reservations.IdentificationFields;
+import hotel.reservations.Price;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+
+/**
+ * How a kind of document is written. The sequence of the text is fixed here; each kind of document gives only the
+ * lines that are its own.
+ */
+public abstract class DocumentLayout {
+
+    public final ReservationReceipt issue(Reservation reservation, Room room) {
+        IdentificationFields id = reservation.guest().identification().fields();
+        Price price = reservation.price();
+        return new ReservationReceipt(
+                title(),
+                reservation.id(),
+                reservation.guest().name(),
+                id.cpf(),
+                id.companyCnpj(),
+                id.companyName(),
+                id.guestPassport(),
+                id.guestCountry(),
+                room.number(),
+                room.type(),
+                reservation.checkIn(),
+                reservation.checkOut(),
+                price.nights(),
+                price.subtotal(),
+                price.discount(),
+                price.total(),
+                text(reservation, room));
+    }
+
+    private String text(Reservation reservation, Room room) {
+        Price price = reservation.price();
+        return headerLine(reservation.id())
+                + identityLines(reservation)
+                + roomLine(room)
+                + stayLine(reservation)
+                + priceLines(price)
+                + closingLines(price);
+    }
+
+    protected abstract String title();
+
+    protected abstract String headerLine(long reservationId);
+
+    /** The lines that say who the document is for; each ends with a line break. */
+    protected abstract String identityLines(Reservation reservation);
+
+    protected abstract String roomLine(Room room);
+
+    protected abstract String stayLine(Reservation reservation);
+
+    /** The subtotal, the discount (only when there is one) and the total; each line ends with a line break. */
+    protected abstract String priceLines(Price price);
+
+    /** What comes after the total; nothing, unless the kind of document says otherwise. */
+    protected String closingLines(Price price) {
+        return "";
+    }
+}
