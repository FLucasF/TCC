--- /dev/null
+++ b/src/main/java/hotel/documents/HostingInvoice.java
@@ -0,0 +1,63 @@
+package hotel.documents;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import hotel.rooms.RoomType;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+
+public record HostingInvoice(
+        String title,
+        long reservationId,
+        String companyCnpj,
+        String companyName,
+        String guestName,
+        int roomNumber,
+        RoomType roomType,
+        LocalDate checkIn,
+        LocalDate checkOut,
+        int nights,
+        BigDecimal subtotal,
+        BigDecimal discount,
+        BigDecimal total) {
+
+    public HostingInvoice(Reservation reservation, Room room) {
+        this(
+                "Fatura de hospedagem",
+                reservation.id(),
+                reservation.guest().companyCnpj(),
+                reservation.guest().companyName(),
+                reservation.guest().name(),
+                room.number(),
+                room.type(),
+                reservation.checkIn(),
+                reservation.checkOut(),
+                reservation.price().nights(),
+                reservation.price().subtotal(),
+                reservation.price().discount(),
+                reservation.price().total());
+    }
+
+    public String text() {
+        StringBuilder text = new StringBuilder();
+        text.append(title).append(" nº ").append(reservationId).append('\n');
+        text.append("Empresa: ").append(companyName).append(" (CNPJ ").append(companyCnpj).append(")\n");
+        text.append("Hóspede: ").append(guestName).append('\n');
+        text.append("Quarto: ").append(roomNumber).append(" (").append(roomType).append(")\n");
+        text.append("Entrada: ").append(TextFormat.date(checkIn))
+                .append(" | Saída: ").append(TextFormat.date(checkOut))
+                .append(" | ").append(nights).append(nights == 1 ? " diária" : " diárias").append('\n');
+        text.append("Diárias: ").append(TextFormat.money(subtotal)).append('\n');
+        if (discount.signum() > 0) {
+            text.append("Desconto: ").append(TextFormat.money(discount)).append('\n');
+        }
+        text.append("Total: ").append(TextFormat.money(total)).append('\n');
+
+        BigDecimal issRate = new BigDecimal("0.05");
+        BigDecimal iss = total.multiply(issRate).setScale(2, RoundingMode.HALF_EVEN);
+        text.append("ISS retido (5%): ").append(TextFormat.money(iss)).append('\n');
+
+        return text.toString();
+    }
+}
diff --git a/src/main/java/hotel/documents/InternationalReceipt.java b/src/main/java/hotel/documents/InternationalReceipt.java
new file mode 100644
index 0000000..7e009f4
--- /dev/null
+++ b/src/main/java/hotel/documents/InternationalReceipt.java
@@ -0,0 +1,68 @@
+package hotel.documents;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import hotel.rooms.RoomType;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.format.DateTimeFormatter;
+import java.util.Locale;
+
+public record InternationalReceipt(
+        String title,
+        long reservationId,
+        String guestName,
+        String guestPassport,
+        String guestCountry,
+        int roomNumber,
+        RoomType roomType,
+        LocalDate checkIn,
+        LocalDate checkOut,
+        int nights,
+        BigDecimal subtotal,
+        BigDecimal discount,
+        BigDecimal total) {
+
+    public InternationalReceipt(Reservation reservation, Room room) {
+        this(
+                "Booking receipt",
+                reservation.id(),
+                reservation.guest().name(),
+                reservation.guest().passport(),
+                reservation.guest().country(),
+                room.number(),
+                room.type(),
+                reservation.checkIn(),
+                reservation.checkOut(),
+                reservation.price().nights(),
+                reservation.price().subtotal(),
+                reservation.price().discount(),
+                reservation.price().total());
+    }
+
+    public String text() {
+        StringBuilder text = new StringBuilder();
+        text.append(title).append(" no. ").append(reservationId).append('\n');
+        text.append("Guest: ").append(guestName)
+                .append(" (passport ").append(guestPassport)
+                .append(", ").append(guestCountry).append(")\n");
+        text.append("Room: ").append(roomNumber).append(" (").append(roomType).append(")\n");
+        text.append("Check-in: ").append(formatIsoDate(checkIn))
+                .append(" | Check-out: ").append(formatIsoDate(checkOut))
+                .append(" | ").append(nights).append(nights == 1 ? " night" : " nights").append('\n');
+        text.append("Nights: ").append(formatInternationalMoney(subtotal)).append('\n');
+        if (discount.signum() > 0) {
+            text.append("Discount: ").append(formatInternationalMoney(discount)).append('\n');
+        }
+        text.append("Total: ").append(formatInternationalMoney(total)).append('\n');
+        return text.toString();
+    }
+
+    private static String formatIsoDate(LocalDate date) {
+        return date.format(DateTimeFormatter.ISO_LOCAL_DATE);
+    }
+
+    private static String formatInternationalMoney(BigDecimal amount) {
+        return "BRL " + String.format(Locale.US, "%,.2f", amount);
+    }
+}
diff --git a/src/main/java/hotel/documents/ReservationDocument.java b/src/main/java/hotel/documents/ReservationDocument.java
new file mode 100644
index 0000000..80870e2
--- /dev/null
+++ b/src/main/java/hotel/documents/ReservationDocument.java
@@ -0,0 +1,91 @@
+package hotel.documents;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import hotel.rooms.RoomType;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+public record ReservationDocument(
+        String title,
+        long reservationId,
+        String guestName,
+        String guestCpf,
+        String companyCnpj,
+        String companyName,
+        String guestPassport,
+        String guestCountry,
+        int roomNumber,
+        RoomType roomType,
+        LocalDate checkIn,
+        LocalDate checkOut,
+        int nights,
+        BigDecimal subtotal,
+        BigDecimal discount,
+        BigDecimal total,
+        String text) {
+
+    public static ReservationDocument from(Reservation reservation, Room room) {
+        if (reservation.guest().isIndividual()) {
+            ReservationReceipt receipt = new ReservationReceipt(reservation, room);
+            return new ReservationDocument(
+                    receipt.title(),
+                    receipt.reservationId(),
+                    receipt.guestName(),
+                    receipt.guestCpf(),
+                    null,
+                    null,
+                    null,
+                    null,
+                    receipt.roomNumber(),
+                    receipt.roomType(),
+                    receipt.checkIn(),
+                    receipt.checkOut(),
+                    receipt.nights(),
+                    receipt.subtotal(),
+                    receipt.discount(),
+                    receipt.total(),
+                    receipt.text());
+        } else if (reservation.guest().isCompany()) {
+            HostingInvoice invoice = new HostingInvoice(reservation, room);
+            return new ReservationDocument(
+                    invoice.title(),
+                    invoice.reservationId(),
+                    invoice.guestName(),
+                    null,
+                    invoice.companyCnpj(),
+                    invoice.companyName(),
+                    null,
+                    null,
+                    invoice.roomNumber(),
+                    invoice.roomType(),
+                    invoice.checkIn(),
+                    invoice.checkOut(),
+                    invoice.nights(),
+                    invoice.subtotal(),
+                    invoice.discount(),
+                    invoice.total(),
+                    invoice.text());
+        } else {
+            InternationalReceipt receipt = new InternationalReceipt(reservation, room);
+            return new ReservationDocument(
+                    receipt.title(),
+                    receipt.reservationId(),
+                    receipt.guestName(),
+                    null,
+                    null,
+                    null,
+                    receipt.guestPassport(),
+                    receipt.guestCountry(),
+                    receipt.roomNumber(),
+                    receipt.roomType(),
+                    receipt.checkIn(),
+                    receipt.checkOut(),
+                    receipt.nights(),
+                    receipt.subtotal(),
+                    receipt.discount(),
+                    receipt.total(),
+                    receipt.text());
+        }
+    }
+}
