@@ -0,0 +1,68 @@
+package hotel.documents;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import hotel.rooms.RoomType;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.format.DateTimeFormatter;
+import java.util.Locale;
+
+/** Booking receipt in English for foreign guests. */
+public record BookingReceipt(
+        String title,
+        long reservationId,
+        String guestName,
+        String guestPassport,
+        String guestCountry,
+        int roomNumber,
+        RoomType roomType,
+        LocalDate checkIn,
+        LocalDate checkOut,
+        int nights,
+        BigDecimal subtotal,
+        BigDecimal discount,
+        BigDecimal total) {
+
+    private static final DateTimeFormatter ISO_DATE = DateTimeFormatter.ISO_LOCAL_DATE;
+    private static final Locale US = Locale.US;
+
+    public BookingReceipt(Reservation reservation, Room room) {
+        this(
+                "Booking receipt",
+                reservation.id(),
+                reservation.guest().name(),
+                reservation.guest().passport(),
+                reservation.guest().country(),
+                room.number(),
+                room.type(),
+                reservation.checkIn(),
+                reservation.checkOut(),
+                reservation.price().nights(),
+                reservation.price().subtotal(),
+                reservation.price().discount(),
+                reservation.price().total());
+    }
+
+    public String text() {
+        StringBuilder text = new StringBuilder();
+        text.append(title).append(" no. ").append(reservationId).append('\n');
+        text.append("Guest: ").append(guestName)
+                .append(" (passport ").append(guestPassport)
+                .append(", ").append(guestCountry).append(")\n");
+        text.append("Room: ").append(roomNumber).append(" (").append(roomType).append(")\n");
+        text.append("Check-in: ").append(ISO_DATE.format(checkIn))
+                .append(" | Check-out: ").append(ISO_DATE.format(checkOut))
+                .append(" | ").append(nights).append(nights == 1 ? " night" : " nights").append('\n');
+        text.append("Nights: ").append(formatMoney(subtotal)).append('\n');
+        if (discount.signum() > 0) {
+            text.append("Discount: ").append(formatMoney(discount)).append('\n');
+        }
+        text.append("Total: ").append(formatMoney(total)).append('\n');
+        return text.toString();
+    }
+
+    private static String formatMoney(BigDecimal amount) {
+        return "BRL " + String.format(US, "%,.2f", amount);
+    }
+}
diff --git a/src/main/java/hotel/documents/DocumentReceipt.java b/src/main/java/hotel/documents/DocumentReceipt.java
new file mode 100644
index 0000000..e2585bd
--- /dev/null
+++ b/src/main/java/hotel/documents/DocumentReceipt.java
@@ -0,0 +1,99 @@
+package hotel.documents;
+
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import hotel.rooms.RoomType;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** Unified document for all types of reservations. */
+public record DocumentReceipt(
+        String title,
+        long reservationId,
+        String guestName,
+        String guestCpf,
+        String companyCnpj,
+        String companyName,
+        String guestPassport,
+        String guestCountry,
+        int roomNumber,
+        RoomType roomType,
+        LocalDate checkIn,
+        LocalDate checkOut,
+        int nights,
+        BigDecimal subtotal,
+        BigDecimal discount,
+        BigDecimal total,
+        String text) {
+
+    public static DocumentReceipt of(Reservation reservation, Room room) {
+        return switch (reservation.guest().type()) {
+            case INDIVIDUAL -> fromReservationReceipt(new ReservationReceipt(reservation, room));
+            case COMPANY -> fromInvoiceReceipt(new InvoiceReceipt(reservation, room));
+            case FOREIGN -> fromBookingReceipt(new BookingReceipt(reservation, room));
+        };
+    }
+
+    private static DocumentReceipt fromReservationReceipt(ReservationReceipt receipt) {
+        return new DocumentReceipt(
+                receipt.title(),
+                receipt.reservationId(),
+                receipt.guestName(),
+                receipt.guestCpf(),
+                null,
+                null,
+                null,
+                null,
+                receipt.roomNumber(),
+                receipt.roomType(),
+                receipt.checkIn(),
+                receipt.checkOut(),
+                receipt.nights(),
+                receipt.subtotal(),
+                receipt.discount(),
+                receipt.total(),
+                receipt.text());
+    }
+
+    private static DocumentReceipt fromInvoiceReceipt(InvoiceReceipt receipt) {
+        return new DocumentReceipt(
+                receipt.title(),
+                receipt.reservationId(),
+                receipt.guestName(),
+                null,
+                receipt.companyCnpj(),
+                receipt.companyName(),
+                null,
+                null,
+                receipt.roomNumber(),
+                receipt.roomType(),
+                receipt.checkIn(),
+                receipt.checkOut(),
+                receipt.nights(),
+                receipt.subtotal(),
+                receipt.discount(),
+                receipt.total(),
+                receipt.text());
+    }
+
+    private static DocumentReceipt fromBookingReceipt(BookingReceipt receipt) {
+        return new DocumentReceipt(
+                receipt.title(),
+                receipt.reservationId(),
+                receipt.guestName(),
+                null,
+                null,
+                null,
+                receipt.guestPassport(),
+                receipt.guestCountry(),
+                receipt.roomNumber(),
+                receipt.roomType(),
+                receipt.checkIn(),
+                receipt.checkOut(),
+                receipt.nights(),
+                receipt.subtotal(),
+                receipt.discount(),
+                receipt.total(),
+                receipt.text());
+    }
+}
