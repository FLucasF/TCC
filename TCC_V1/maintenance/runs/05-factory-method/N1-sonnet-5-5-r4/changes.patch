+        int ways = (anyCpf ? 1 : 0) + (anyCompany ? 1 : 0) + (anyPassport ? 1 : 0);
+        if (ways != 1 || (anyCompany && !company) || (anyPassport && !passport)) {
+            throw new HotelException(ErrorCode.INVALID_REQUEST,
+                    "identify the guest by the CPF, or by the CNPJ with the company name, "
+                            + "or by the passport with the country");
+        }
+        if (company) {
+            return new Identification.Company(body.companyCnpj(), body.companyName());
+        }
+        if (passport) {
+            return new Identification.Passport(body.guestPassport(), body.guestCountry());
+        }
+        return new Identification.Cpf(body.guestCpf());
+    }
