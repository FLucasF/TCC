+        assertTrue(emailBody.contains("Sua reserva na Pousada Maré Alta está confirmada"));
+        assertTrue(emailBody.contains("Fatura de hospedagem"));
+
+        HttpResponse<String> document = get("/reservations/" + id + "/document");
