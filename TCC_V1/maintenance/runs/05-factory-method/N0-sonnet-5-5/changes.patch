@@ -159,4 +159,51 @@ class ReservationServiceTest {
     void anUnknownReservationIsNotFound() {
         assertEquals(ErrorCode.RESERVATION_NOT_FOUND, errorOf(() -> service.find(42)));
     }
+
+    private static NewReservation stayOf(Guest guest, int roomNumber, String checkIn, String checkOut) {
+        return new NewReservation(
+                roomNumber, guest, LocalDate.parse(checkIn), LocalDate.parse(checkOut), 2, RatePlan.STANDARD);
+    }
+
+    @Test
+    void aCompanyGetsAnInvoiceWithTheWithheldIss() {
+        Guest guest = new Guest("Ana Souza", "ana@example.com", null, "12.345.678/0001-90", "Tecnosul Ltda", null, null);
+        Reservation reservation = service.create(stayOf(guest, 201, "2027-03-10", "2027-03-12"));
+        service.confirm(reservation.id());
+
+        ReservationReceipt document = service.receiptCopy(reservation.id());
+
+        String expected = """
+                Fatura de hospedagem nº 1
+                Empresa: Tecnosul Ltda (CNPJ 12.345.678/0001-90)
+                Hóspede: Ana Souza
+                Quarto: 201 (DELUXE)
+                Entrada: 10/03/2027 | Saída: 12/03/2027 | 2 diárias
+                Diárias: R$ 779,80
+                Total: R$ 779,80
+                ISS retido (5%): R$ 38,99
+                """;
+        assertEquals(expected, document.text());
+        assertNull(document.guestCpf());
+        assertTrue(sentMessages.all().get(0).body().contains(expected));
+    }
+
+    @Test
+    void aForeignerGetsAnEnglishBookingReceipt() {
+        Guest guest = new Guest("John Smith", "john@example.com", null, null, null, "X1234567", "United Kingdom");
+        Reservation reservation = service.create(stayOf(guest, 201, "2027-03-10", "2027-03-12"));
+        service.confirm(reservation.id());
+
+        String expected = """
+                Booking receipt no. 1
+                Guest: John Smith (passport X1234567, United Kingdom)
+                Room: 201 (DELUXE)
+                Check-in: 2027-03-10 | Check-out: 2027-03-12 | 2 nights
+                Nights: BRL 779.80
+                Total: BRL 779.80
+                """;
+        assertEquals(expected, service.receiptCopy(reservation.id()).text());
+        assertEquals("Reserva confirmada - Pousada Maré Alta", sentMessages.all().get(0).subject());
+        assertTrue(sentMessages.all().get(0).body().startsWith("Olá, John Smith!"));
+    }
 }
