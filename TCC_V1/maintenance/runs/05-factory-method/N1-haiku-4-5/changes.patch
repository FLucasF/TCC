+
+    @Test
+    void createsReservationWithCompanyCnpj() throws Exception {
+        String reservationJson = """
+                {"roomNumber": 201, "guestName": "Ana Souza", "guestEmail": "ana@example.com",
+                 "companyCnpj": "12.345.678/0001-90", "companyName": "Tecnosul Ltda",
+                 "checkIn": "2027-03-10", "checkOut": "2027-03-12",
+                 "guests": 1, "ratePlan": "STANDARD"}
+                """;
+        HttpResponse<String> created = post("/reservations", reservationJson);
+        assertEquals(201, created.statusCode());
+        JsonNode reservation = json.readTree(created.body());
+        assertEquals("Ana Souza", reservation.get("guestName").asText());
+        assertEquals("12.345.678/0001-90", reservation.get("companyCnpj").asText());
+        assertEquals("Tecnosul Ltda", reservation.get("companyName").asText());
+        assertTrue(reservation.get("guestCpf").isNull());
+
+        long id = reservation.get("id").asLong();
+        assertEquals(200, post("/reservations/" + id + "/confirmation", "").statusCode());
+        HttpResponse<String> checkOutResponse = post("/reservations/" + id + "/check-in", "");
+        assertEquals(200, checkOutResponse.statusCode());
+        checkOutResponse = post("/reservations/" + id + "/check-out", "");
+        assertEquals(200, checkOutResponse.statusCode());
+        JsonNode receipt = json.readTree(checkOutResponse.body());
+        assertEquals("Fatura de hospedagem", receipt.get("title").asText());
+        assertTrue(receipt.get("text").asText().contains("Empresa: Tecnosul Ltda"));
+        assertTrue(receipt.get("text").asText().contains("ISS retido (5%)"));
+    }
+
+    @Test
+    void createsReservationWithPassport() throws Exception {
+        String reservationJson = """
+                {"roomNumber": 201, "guestName": "John Smith", "guestEmail": "john@example.com",
+                 "guestPassport": "X1234567", "guestCountry": "United Kingdom",
+                 "checkIn": "2027-03-10", "checkOut": "2027-03-12",
+                 "guests": 1, "ratePlan": "STANDARD"}
+                """;
+        HttpResponse<String> created = post("/reservations", reservationJson);
+        assertEquals(201, created.statusCode());
+        JsonNode reservation = json.readTree(created.body());
+        assertEquals("John Smith", reservation.get("guestName").asText());
+        assertEquals("X1234567", reservation.get("guestPassport").asText());
+        assertEquals("United Kingdom", reservation.get("guestCountry").asText());
+        assertTrue(reservation.get("guestCpf").isNull());
+
+        long id = reservation.get("id").asLong();
+        assertEquals(200, post("/reservations/" + id + "/confirmation", "").statusCode());
+        post("/reservations/" + id + "/check-in", "");
+        HttpResponse<String> checkOutResponse = post("/reservations/" + id + "/check-out", "");
+        assertEquals(200, checkOutResponse.statusCode());
+        JsonNode receipt = json.readTree(checkOutResponse.body());
+        assertEquals("Booking receipt", receipt.get("title").asText());
+        String text = receipt.get("text").asText();
+        assertTrue(text.contains("Guest: John Smith"));
+        assertTrue(text.contains("2027-03-10"));
+        assertTrue(text.contains("BRL"));
+    }
+
