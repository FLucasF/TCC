+package hotel.web;
+
+import hotel.documents.ReservationDocument;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+public record DocumentResponse(
+        String title,
+        long reservationId,
+        String guestName,
+        String guestCpf,
+        String companyCnpj,
+        String companyName,
+        String guestPassport,
+        String guestCountry,
+        int roomNumber,
+        String roomType,
+        LocalDate checkIn,
+        LocalDate checkOut,
+        int nights,
+        BigDecimal subtotal,
+        BigDecimal discount,
+        BigDecimal total,
+        String text) {
+
+    public DocumentResponse(ReservationDocument document) {
