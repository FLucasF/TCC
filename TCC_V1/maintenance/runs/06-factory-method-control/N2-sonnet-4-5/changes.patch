+    @Test
+    void reservationWithChildrenIsAccepted() throws Exception {
+        String reservationWithChildren = """
+                {"roomNumber": 201, "guestName": "Familia Silva", "guestEmail": "silva@example.com",
+                 "guestCpf": "222.333.444-55", "checkIn": "2027-08-10", "checkOut": "2027-08-12",
+                 "guests": 2, "children": 1, "ratePlan": "STANDARD"}
+                """;
+
+        HttpResponse<String> created = post("/reservations", reservationWithChildren);
+
+        assertEquals(201, created.statusCode());
