diff --git a/src/main/java/hotel/reports/CsvReport.java b/src/main/java/hotel/reports/CsvReport.java
new file mode 100644
index 0000000..9760db3
--- /dev/null
+++ b/src/main/java/hotel/reports/CsvReport.java
@@ -0,0 +1,35 @@
+package hotel.reports;
+
+import java.util.List;
+
+/**
+ * The shape every report shares: a title line (inn, report name and period), the header, one line per row
+ * and the total. Each report says only what is its own.
+ */
+public abstract class CsvReport<P, T> {
+
+    private static final String INN = "Pousada Maré Alta";
+
+    /** The report's name, as it appears in the title and in the URL. */
+    public abstract String name();
+
+    protected abstract String header();
+
+    protected abstract List<T> rows(P period);
+
+    protected abstract String line(T row);
+
+    protected abstract String total(List<T> rows);
+
+    public final String generate(P period) {
+        List<T> rows = rows(period);
+        StringBuilder csv = new StringBuilder();
+        csv.append(INN).append(',').append(name()).append(',').append(period).append('\n');
+        csv.append(header()).append('\n');
+        for (T row : rows) {
+            csv.append(line(row)).append('\n');
+        }
+        csv.append(total(rows)).append('\n');
+        return csv.toString();
+    }
+}
diff --git a/src/main/java/hotel/reports/MonthlyRevenue.java b/src/main/java/hotel/reports/MonthlyRevenue.java
new file mode 100644
index 0000000..c588496
--- /dev/null
+++ b/src/main/java/hotel/reports/MonthlyRevenue.java
@@ -0,0 +1,28 @@
+package hotel.reports;
+
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationStore;
+import java.time.YearMonth;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** The reservations that start in a month and left money with the inn, in the financial report's order. */
+final class MonthlyRevenue {
+
+    private MonthlyRevenue() {
+    }
+
+    static List<Reservation> of(ReservationStore store, YearMonth month) {
+        List<Reservation> withRevenue = new ArrayList<>();
+        for (Reservation reservation : store.all()) {
+            boolean keptMoney = reservation.amountKept().signum() > 0;
+            boolean startsInMonth = YearMonth.from(reservation.checkIn()).equals(month);
+            if (keptMoney && startsInMonth) {
+                withRevenue.add(reservation);
+            }
+        }
+        withRevenue.sort(Comparator.comparing(Reservation::checkIn).thenComparingLong(Reservation::id));
+        return withRevenue;
+    }
+}
