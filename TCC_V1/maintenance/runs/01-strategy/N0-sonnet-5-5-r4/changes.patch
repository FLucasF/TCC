+
+    /** The sum of the nights (with high season), less the given fraction of it as discount. */
+    Price nightlyPrice(Room room, LocalDate checkIn, LocalDate checkOut, BigDecimal discountRate) {
         int nights = 0;
         BigDecimal subtotal = cents(BigDecimal.ZERO);
         for (LocalDate night = checkIn; night.isBefore(checkOut); night = night.plusDays(1)) {
             subtotal = subtotal.add(nightPrice(room, night));
             nights++;
         }
-        BigDecimal discount = switch (ratePlan) {
