diff --git a/src/main/java/hotel/reservations/CorporateRule.java b/src/main/java/hotel/reservations/CorporateRule.java
new file mode 100644
index 0000000..96a3240
--- /dev/null
+++ b/src/main/java/hotel/reservations/CorporateRule.java
@@ -0,0 +1,30 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.Map;
+
+/** Agreement with companies: each one has its own discount, and the guest gives the company code. */
+final class CorporateRule implements RatePlanRule {
+
+    private static final Map<String, BigDecimal> DISCOUNT_BY_COMPANY = Map.of(
+            "TECNOSUL", new BigDecimal("0.12"),
+            "AGROVALE", new BigDecimal("0.18"),
+            "FARMAVIDA", new BigDecimal("0.25"));
+
+    @Override
+    public Price price(Room room, LocalDate checkIn, LocalDate checkOut, String companyCode, Price standardPrice) {
+        BigDecimal discount = companyCode == null ? null : DISCOUNT_BY_COMPANY.get(companyCode);
+        if (discount == null) {
+            throw new HotelException(
+                    ErrorCode.INVALID_REQUEST, "the corporate plan needs the code of a company with an agreement");
+        }
+        return RatePlanRule.withDiscount(standardPrice, discount);
+    }
+
+    @Override
+    public BigDecimal refund(BigDecimal amountPaid) {
+        return amountPaid;
+    }
+}
diff --git a/src/main/java/hotel/reservations/LongStayRule.java b/src/main/java/hotel/reservations/LongStayRule.java
