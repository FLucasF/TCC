diff --git a/src/main/java/hotel/reservations/CorporatePlan.java b/src/main/java/hotel/reservations/CorporatePlan.java
new file mode 100644
index 0000000..e683fb6
--- /dev/null
+++ b/src/main/java/hotel/reservations/CorporatePlan.java
@@ -0,0 +1,22 @@
+package hotel.reservations;
+
+import java.math.BigDecimal;
+import java.util.Map;
+
+/** The discount agreed with a company, chosen by the company code the guest gives. */
+final class CorporatePlan extends DiscountedPlan {
+
+    private static final Map<String, BigDecimal> DISCOUNT_BY_COMPANY = Map.of(
+            "TECNOSUL", new BigDecimal("0.12"),
+            "AGROVALE", new BigDecimal("0.18"),
+            "FARMAVIDA", new BigDecimal("0.25"));
+
+    @Override
+    protected BigDecimal discountRate(NewReservation request, Price regularPrice) {
+        BigDecimal discount = request.companyCode() == null ? null : DISCOUNT_BY_COMPANY.get(request.companyCode());
+        if (discount == null) {
+            throw new HotelException(ErrorCode.INVALID_REQUEST, "the corporate rate needs the code of a partner company");
+        }
+        return discount;
+    }
+}
diff --git a/src/main/java/hotel/reservations/DiscountedPlan.java b/src/main/java/hotel/reservations/DiscountedPlan.java
new file mode 100644
index 0000000..e3ad0e2
--- /dev/null
+++ b/src/main/java/hotel/reservations/DiscountedPlan.java
@@ -0,0 +1,23 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** A plan that gives a percentage off the sum of the nights. Cancelling gives back everything paid. */
+abstract class DiscountedPlan implements RatePlanPolicy {
+
+    /** The fraction taken off the regular price; throws INVALID_REQUEST when the plan does not allow the request. */
+    protected abstract BigDecimal discountRate(NewReservation request, Price regularPrice);
+
+    @Override
+    public final Price price(Room room, NewReservation request, Price regularPrice) {
+        BigDecimal discount = PriceCalculator.cents(regularPrice.subtotal().multiply(discountRate(request, regularPrice)));
+        return new Price(
+                regularPrice.nights(), regularPrice.subtotal(), discount, regularPrice.subtotal().subtract(discount));
+    }
+
+    @Override
+    public BigDecimal refund(Reservation reservation) {
+        return reservation.amountPaid();
+    }
+}
