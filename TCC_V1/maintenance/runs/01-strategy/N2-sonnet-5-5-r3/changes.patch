 - **Reserva:** nasce `PENDING`. Quando o hóspede paga, é confirmada (`CONFIRMED`), e ele recebe o
   comprovante por e-mail. Depois vêm o check-in (`CHECKED_IN`) e o check-out (`CHECKED_OUT`), que
   entrega o comprovante final.
diff --git a/src/main/java/hotel/reservations/CorporateRule.java b/src/main/java/hotel/reservations/CorporateRule.java
new file mode 100644
index 0000000..3286c61
--- /dev/null
+++ b/src/main/java/hotel/reservations/CorporateRule.java
@@ -0,0 +1,28 @@
+package hotel.reservations;
+
+import java.math.BigDecimal;
+import java.util.Map;
+
+/** The discount depends on the company the guest has an agreement through, named by its code. */
+final class CorporateRule extends DiscountedRule {
+
+    private static final Map<String, BigDecimal> DISCOUNT_BY_COMPANY = Map.of(
+            "TECNOSUL", new BigDecimal("0.12"),
+            "AGROVALE", new BigDecimal("0.18"),
+            "FARMAVIDA", new BigDecimal("0.25"));
+
+    @Override
+    protected BigDecimal discountRate(NewReservation request) {
+        BigDecimal discount = request.companyCode() == null ? null : DISCOUNT_BY_COMPANY.get(request.companyCode());
+        if (discount == null) {
+            throw new HotelException(
+                    ErrorCode.INVALID_REQUEST, "the corporate rate needs the code of a company with an agreement");
+        }
+        return discount;
+    }
+
+    @Override
+    public BigDecimal refund(Reservation reservation) {
+        return reservation.amountPaid();
+    }
+}
diff --git a/src/main/java/hotel/reservations/DiscountedRule.java b/src/main/java/hotel/reservations/DiscountedRule.java
new file mode 100644
index 0000000..bf7da12
--- /dev/null
+++ b/src/main/java/hotel/reservations/DiscountedRule.java
@@ -0,0 +1,18 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** A plan that takes a percentage off the sum of the nights. */
+abstract class DiscountedRule implements RatePlanRule {
+
+    @Override
+    public Price price(Room room, NewReservation request, Price undiscounted) {
+        BigDecimal discount = PriceCalculator.cents(undiscounted.subtotal().multiply(discountRate(request)));
+        return new Price(
+                undiscounted.nights(), undiscounted.subtotal(), discount, undiscounted.subtotal().subtract(discount));
+    }
+
+    /** The fraction taken off, e.g. 0.15; refuses the request when the plan does not apply to it. */
+    protected abstract BigDecimal discountRate(NewReservation request);
+}
diff --git a/src/main/java/hotel/reservations/LongStayRule.java b/src/main/java/hotel/reservations/LongStayRule.java
new file mode 100644
index 0000000..063ff42
--- /dev/null
+++ b/src/main/java/hotel/reservations/LongStayRule.java
@@ -0,0 +1,25 @@
+package hotel.reservations;
+
+import java.math.BigDecimal;
+import java.time.temporal.ChronoUnit;
+
+final class LongStayRule extends DiscountedRule {
+
+    static final int MINIMUM_NIGHTS = 7;
+    static final BigDecimal DISCOUNT = new BigDecimal("0.10");
+
+    @Override
+    protected BigDecimal discountRate(NewReservation request) {
+        long nights = ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+        if (nights < MINIMUM_NIGHTS) {
+            throw new HotelException(
+                    ErrorCode.INVALID_REQUEST, "the long stay rate needs at least " + MINIMUM_NIGHTS + " nights");
+        }
+        return DISCOUNT;
+    }
+
+    @Override
+    public BigDecimal refund(Reservation reservation) {
+        return reservation.amountPaid();
+    }
+}
