+    private void validateRatePlanRequirements(NewReservation request) {
+        switch (request.ratePlan()) {
+            case CORPORATE:
+                if (request.companyCode() == null
+                        || !CompanyDiscount.isValid(request.companyCode())) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "invalid or missing company code for corporate plan");
+                }
+                break;
+            case WEEKEND_PACKAGE:
+                if (!isWeekendPackageDateValid(request.checkIn(), request.checkOut())) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "weekend package must be Friday to Sunday (exactly 2 nights)");
+                }
+                break;
+            case LONG_STAY:
+                int nights = (int) ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+                if (nights < 7) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "long stay plan requires at least 7 nights");
+                }
+                break;
+            case STANDARD, NON_REFUNDABLE:
+                break;
+        }
+    }
+
+    private boolean isWeekendPackageDateValid(LocalDate checkIn, LocalDate checkOut) {
+        if (checkOut.minusDays(2).compareTo(checkIn) != 0) {
+            return false;
+        }
+        DayOfWeek dayOfWeek = checkIn.getDayOfWeek();
+        return dayOfWeek == DayOfWeek.FRIDAY;
+    }
