+                errorOf(() -> service.create(stay(101, "2027-03-12", "2027-03-13", 2, RatePlan.WEEKEND_PACKAGE))));
+
+        Reservation reservation = service.create(stay(101, "2027-03-12", "2027-03-14", 2, RatePlan.WEEKEND_PACKAGE));
+        assertEquals(new BigDecimal("520.00"), reservation.price().total());
+    }
+
+    @Test
+    void weekendPackageRefundsHalfOnCancellation() {
+        Reservation reservation = service.create(stay(201, "2027-03-12", "2027-03-14", 2, RatePlan.WEEKEND_PACKAGE));
+        service.confirm(reservation.id());
+
+        assertEquals(new BigDecimal("410.00"), service.cancel(reservation.id()).refund());
+    }
+
+    @Test
+    void longStayRequiresAtLeastSevenNights() {
+        assertEquals(ErrorCode.INVALID_REQUEST,
+                errorOf(() -> service.create(stay(101, "2027-03-01", "2027-03-07", 2, RatePlan.LONG_STAY))));
+
+        Reservation reservation = service.create(stay(101, "2027-03-01", "2027-03-08", 2, RatePlan.LONG_STAY));
+        assertEquals(new BigDecimal("1574.37"), reservation.price().total());
+    }
+
+    @Test
+    void longStayRefundsEverythingOnCancellation() {
+        Reservation reservation = service.create(stay(101, "2027-03-01", "2027-03-10", 2, RatePlan.LONG_STAY));
+        service.confirm(reservation.id());
+
+        // 9 nights of 249.90 = 2249.10, 10% discount = 224.91, total = 2024.19
+        assertEquals(new BigDecimal("2024.19"), service.cancel(reservation.id()).refund());
+    }
 }
