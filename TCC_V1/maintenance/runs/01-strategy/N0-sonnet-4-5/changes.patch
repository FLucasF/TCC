+        Reservation reservation = service.create(weekend);
+        service.confirm(reservation.id());
+
+        service.cancel(reservation.id());
+
+        // Finance verified: package costs 820.00, cancellation refunds 410.00
+        assertEquals(new BigDecimal("820.00"), reservation.amountPaid());
+        assertEquals(new BigDecimal("410.00"), reservation.refund());
+        assertEquals(new BigDecimal("410.00"), reservation.amountKept());
+    }
+
+    @Test
+    void cancellingCorporateRefunds100Percent() {
+        Guest guest = new Guest("Test Guest", "test@example.com", "000.000.000-00");
+        NewReservation corporate = new NewReservation(
+                101, guest, LocalDate.of(2027, 3, 10), LocalDate.of(2027, 3, 12), 2, RatePlan.CORPORATE, "TECNOSUL");
+        Reservation reservation = service.create(corporate);
+        service.confirm(reservation.id());
+
+        service.cancel(reservation.id());
+
+        // 2 nights of 249.90 = 499.80; 12% discount = 59.98; total paid = 439.82; 100% refund
+        assertEquals(new BigDecimal("439.82"), reservation.refund());
+        assertEquals(new BigDecimal("0.00"), reservation.amountKept());
+    }
+
+    @Test
+    void cancellingLongStayRefunds100Percent() {
+        Guest guest = new Guest("Test Guest", "test@example.com", "000.000.000-00");
+        NewReservation longStay = new NewReservation(
+                101, guest, LocalDate.of(2027, 3, 1), LocalDate.of(2027, 3, 8), 2, RatePlan.LONG_STAY, null);
+        Reservation reservation = service.create(longStay);
+        service.confirm(reservation.id());
+
+        service.cancel(reservation.id());
+
+        assertEquals(new BigDecimal("1574.37"), reservation.refund());
+        assertEquals(new BigDecimal("0.00"), reservation.amountKept());
+    }
 }
