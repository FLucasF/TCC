 | código | status | quando |
 |---|---|---|
-| `INVALID_REQUEST` | 400 | falta um campo, o corpo não é JSON, ou a saída não é depois da entrada |
+| `INVALID_REQUEST` | 400 | falta um campo, o corpo não é JSON, a saída não é depois da entrada, ou o plano não vale para a reserva |
 | `ROOM_NOT_FOUND` | 404 | o quarto não existe |
 | `RESERVATION_NOT_FOUND` | 404 | a reserva não existe |
 | `ROOM_UNAVAILABLE` | 409 | o quarto já está reservado em alguma das noites |
diff --git a/src/main/java/hotel/reservations/Company.java b/src/main/java/hotel/reservations/Company.java
new file mode 100644
index 0000000..b7c2961
--- /dev/null
+++ b/src/main/java/hotel/reservations/Company.java
@@ -0,0 +1,30 @@
+package hotel.reservations;
+
+import java.math.BigDecimal;
+import java.util.Optional;
+
+/** The companies with a corporate agreement; the code a guest informs is the name in upper case. */
+public enum Company {
+    TECNOSUL("0.12"),
+    AGROVALE("0.18"),
+    FARMAVIDA("0.25");
+
+    private final BigDecimal discount;
+
+    Company(String discount) {
+        this.discount = new BigDecimal(discount);
+    }
+
+    public BigDecimal discount() {
+        return discount;
+    }
+
+    public static Optional<Company> find(String code) {
+        for (Company company : values()) {
+            if (company.name().equals(code)) {
+                return Optional.of(company);
+            }
+        }
+        return Optional.empty();
+    }
+}
