+    private void validateRatePlan(NewReservation request) {
+        switch (request.ratePlan()) {
+            case CORPORATE -> {
+                if (request.companyCode() == null
+                        || !PriceCalculator.CORPORATE_DISCOUNTS.containsKey(request.companyCode())) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "CORPORATE rate plan requires a valid company code");
+                }
+            }
+            case WEEKEND_PACKAGE -> {
+                int nights = (int) java.time.temporal.ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+                if (nights != 2) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "WEEKEND_PACKAGE requires exactly 2 nights");
+                }
+                if (request.checkIn().getDayOfWeek() != java.time.DayOfWeek.FRIDAY
+                        || request.checkOut().getDayOfWeek() != java.time.DayOfWeek.SUNDAY) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "WEEKEND_PACKAGE requires check-in on Friday and check-out on Sunday");
+                }
+            }
+            case LONG_STAY -> {
+                int nights = (int) java.time.temporal.ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+                if (nights < 7) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "LONG_STAY requires at least 7 nights");
+                }
+            }
+            default -> {
+                // No additional validation needed for STANDARD and NON_REFUNDABLE
+            }
+        }
+    }
