diff --git a/src/main/java/hotel/reservations/StayTerms.java b/src/main/java/hotel/reservations/StayTerms.java
new file mode 100644
index 0000000..a470858
--- /dev/null
+++ b/src/main/java/hotel/reservations/StayTerms.java
@@ -0,0 +1,13 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+
+/** What a rate plan needs to know about a stay to accept it and price it. */
+public record StayTerms(Room room, LocalDate checkIn, LocalDate checkOut, String companyCode) {
+
+    public int nights() {
+        return (int) ChronoUnit.DAYS.between(checkIn, checkOut);
+    }
+}
