+    private void validateRatePlan(NewReservation request) {
+        switch (request.ratePlan()) {
+            case CORPORATE -> {
+                if (request.companyCode() == null || !isValidCompanyCode(request.companyCode())) {
+                    throw new HotelException(ErrorCode.INVALID_REQUEST, "invalid company code");
+                }
+            }
+            case WEEKEND_PACKAGE -> {
+                if (request.checkIn().getDayOfWeek() != DayOfWeek.FRIDAY
+                        || request.checkOut().getDayOfWeek() != DayOfWeek.SUNDAY) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "weekend package must be from Friday to Sunday");
+                }
+                if (!request.checkOut().equals(request.checkIn().plusDays(2))) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "weekend package must be exactly 2 nights");
+                }
+            }
+            case LONG_STAY -> {
+                int nights = (int) java.time.temporal.ChronoUnit.DAYS.between(
+                        request.checkIn(), request.checkOut());
+                if (nights < 7) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "long stay requires at least 7 nights");
+                }
+            }
+            case STANDARD, NON_REFUNDABLE -> {}
+        }
+    }
+
+    private boolean isValidCompanyCode(String code) {
+        return code.equals("TECNOSUL") || code.equals("AGROVALE") || code.equals("FARMAVIDA");
+    }
+
+    private Price calculatePrice(Room room, NewReservation request) {
+        if (request.ratePlan() == RatePlan.WEEKEND_PACKAGE) {
+            return priceCalculator.calculateWeekendPackage(room, request.checkIn(), request.checkOut());
+        }
+        return priceCalculator.calculate(
+                room, request.checkIn(), request.checkOut(), request.ratePlan(), request.companyCode());
+    }
