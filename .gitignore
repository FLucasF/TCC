# O projeto-cobaia dentro do harness. Existe para o executor ter o que verificar;
# a cópia autoritativa vive fora deste repositório. 125 MB, e o histórico dele não
# é este.
harness/apps/

# Estado local do executor — quais boundaries já foram verificados nesta sessão.
# Derivado, muda a cada edição, e não diz nada a quem lê o histórico.
harness/verify/.state.json

# Traço episódico do executor — um registro JSON por comando verificado. Dado de
# execução por máquina, com teto de registros; não pertence ao histórico. O padrão
# também cobre o temporário do corte, .trace.jsonl.<pid>.tmp.
harness/verify/.trace.jsonl*

# Índice de código, quando existir. Artefato derivado, reconstruível.
graphify-out/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Editor e sistema
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Estado do Obsidian: workspace, plugins e temas vendorizados. Muda a cada abertura.
docs/TCC - obsidian/.obsidian/
