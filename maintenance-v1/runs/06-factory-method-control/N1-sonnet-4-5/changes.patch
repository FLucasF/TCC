diff --git a/src/test/java/hotel/web/HttpApiTest.java b/src/test/java/hotel/web/HttpApiTest.java
index e95e6d1..2312a4f 100644
--- a/src/test/java/hotel/web/HttpApiTest.java
+++ b/src/test/java/hotel/web/HttpApiTest.java
@@ -116,4 +116,51 @@ class HttpApiTest {
         assertEquals(400, get("/reports/revenue?month=july").statusCode());
         assertEquals(400, get("/reports/occupancy").statusCode());
     }
+
+    @Test
+    void childrenFieldIsOptionalInRequest() throws Exception {
+        HttpResponse<String> created = post("/reservations", RESERVATION_JSON);
+        JsonNode reservation = json.readTree(created.body());
+
+        assertEquals(0, reservation.get("children").asInt());
+    }
+
+    @Test
+    void childrenFieldCanBeSpecified() throws Exception {
+        String withChildren = """
+                {"roomNumber": 201, "guestName": "Paula Costa", "guestEmail": "paula@example.com",
+                 "guestCpf": "222.333.444-55", "checkIn": "2027-08-10", "checkOut": "2027-08-12",
+                 "guests": 1, "children": 2, "ratePlan": "STANDARD"}
+                """;
+        HttpResponse<String> created = post("/reservations", withChildren);
+        JsonNode reservation = json.readTree(created.body());
+
+        assertEquals(2, reservation.get("children").asInt());
+    }
+
+    @Test
+    void negativeChildrenIsRejected() throws Exception {
+        String negativeChildren = """
+                {"roomNumber": 101, "guestName": "Paula Costa", "guestEmail": "paula@example.com",
+                 "guestCpf": "222.333.444-55", "checkIn": "2027-08-10", "checkOut": "2027-08-12",
+                 "guests": 1, "children": -1, "ratePlan": "STANDARD"}
+                """;
+        HttpResponse<String> response = post("/reservations", negativeChildren);
+
+        assertEquals(400, response.statusCode());
+        assertEquals("INVALID_REQUEST", json.readTree(response.body()).get("error").asText());
+    }
+
+    @Test
+    void capacityIncludesAdultsAndChildren() throws Exception {
+        String overCapacity = """
+                {"roomNumber": 101, "guestName": "Paula Costa", "guestEmail": "paula@example.com",
+                 "guestCpf": "222.333.444-55", "checkIn": "2027-08-10", "checkOut": "2027-08-12",
+                 "guests": 2, "children": 1, "ratePlan": "STANDARD"}
+                """;
+        HttpResponse<String> response = post("/reservations", overCapacity);
+
+        assertEquals(422, response.statusCode());
+        assertEquals("CAPACITY_EXCEEDED", json.readTree(response.body()).get("error").asText());
+    }
 }
