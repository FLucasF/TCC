diff --git a/src/test/java/hotel/web/HttpApiTest.java b/src/test/java/hotel/web/HttpApiTest.java
index e95e6d1..0189de2 100644
--- a/src/test/java/hotel/web/HttpApiTest.java
+++ b/src/test/java/hotel/web/HttpApiTest.java
@@ -116,4 +116,46 @@ class HttpApiTest {
         assertEquals(400, get("/reports/revenue?month=july").statusCode());
         assertEquals(400, get("/reports/occupancy").statusCode());
     }
+
+    @Test
+    void childrenFieldIsOptionalAndDefaultsToZero() throws Exception {
+        HttpResponse<String> withoutChildren = post("/reservations", RESERVATION_JSON);
+        assertEquals(201, withoutChildren.statusCode());
+        JsonNode reservation = json.readTree(withoutChildren.body());
+        assertEquals(0, reservation.get("children").asInt());
+
+        String withChildren = """
+                {"roomNumber": 301, "guestName": "Maria Silva", "guestEmail": "maria@example.com",
+                 "guestCpf": "222.333.444-55", "checkIn": "2027-07-15", "checkOut": "2027-07-17",
+                 "guests": 2, "ratePlan": "STANDARD", "children": 2}
+                """;
+        HttpResponse<String> response = post("/reservations", withChildren);
+        assertEquals(201, response.statusCode());
+        JsonNode reservationWithChildren = json.readTree(response.body());
+        assertEquals(2, reservationWithChildren.get("children").asInt());
+    }
+
+    @Test
+    void adultsAndChildrenTogetherCannotExceedCapacity() throws Exception {
+        String tooMany = """
+                {"roomNumber": 101, "guestName": "João Costa", "guestEmail": "joao@example.com",
+                 "guestCpf": "333.444.555-66", "checkIn": "2027-08-01", "checkOut": "2027-08-03",
+                 "guests": 2, "ratePlan": "STANDARD", "children": 2}
+                """;
+        HttpResponse<String> response = post("/reservations", tooMany);
+        assertEquals(422, response.statusCode());
+        assertEquals("CAPACITY_EXCEEDED", json.readTree(response.body()).get("error").asText());
+    }
+
+    @Test
+    void childrenCannotBeNegative() throws Exception {
+        String negative = """
+                {"roomNumber": 101, "guestName": "Pedro Santos", "guestEmail": "pedro@example.com",
+                 "guestCpf": "444.555.666-77", "checkIn": "2027-08-10", "checkOut": "2027-08-12",
+                 "guests": 1, "ratePlan": "STANDARD", "children": -1}
+                """;
+        HttpResponse<String> response = post("/reservations", negative);
+        assertEquals(400, response.statusCode());
+        assertEquals("INVALID_REQUEST", json.readTree(response.body()).get("error").asText());
+    }
 }
