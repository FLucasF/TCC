@@ -10,6 +10,29 @@ public final class EmailSender {
     }
 
     public Message send(String to, String subject, String body) {
-        return sentMessages.add("EMAIL", to, subject, body);
+        if (!EmailValidator.isValid(to)) {
+            return sentMessages.add("EMAIL", to, subject, body, MessageStatus.BLOCKED);
+        }
+
+        String testMode = System.getenv("HOTEL_TEST_MODE");
+        boolean isTestMode = "true".equals(testMode);
+
+        String finalTo = to;
+        String finalSubject = subject;
+        String finalBody = body;
+
+        if (isTestMode) {
+            finalTo = "testes@pousadamarealta.com.br";
+            finalSubject = "[TESTE] " + subject;
+            finalBody = "Destinatário original: " + to + "\n" + body;
+        }
+
+        Message sent = sentMessages.add("EMAIL", finalTo, finalSubject, finalBody, MessageStatus.SENT);
+
+        if (!isTestMode) {
+            sentMessages.add("EMAIL", "arquivo@pousadamarealta.com.br", "[Cópia] " + subject, body, MessageStatus.SENT);
+        }
+
+        return sent;
     }
 }
diff --git a/src/main/java/hotel/messages/EmailValidator.java b/src/main/java/hotel/messages/EmailValidator.java
new file mode 100644
index 0000000..c0883dd
--- /dev/null
+++ b/src/main/java/hotel/messages/EmailValidator.java
@@ -0,0 +1,40 @@
+package hotel.messages;
+
+public final class EmailValidator {
+
+    public static boolean isValid(String email) {
+        if (email == null || email.isBlank()) {
+            return false;
+        }
+
+        int atCount = 0;
+        int atIndex = -1;
+
+        for (int i = 0; i < email.length(); i++) {
+            if (email.charAt(i) == '@') {
+                atCount++;
+                atIndex = i;
+            }
+        }
+
+        if (atCount != 1) {
+            return false;
+        }
+
+        String beforeAt = email.substring(0, atIndex);
+        String afterAt = email.substring(atIndex + 1);
+
+        if (beforeAt.isEmpty() || afterAt.isEmpty()) {
+            return false;
+        }
+
+        int dotCount = 0;
+        for (int i = 0; i < afterAt.length(); i++) {
+            if (afterAt.charAt(i) == '.') {
+                dotCount++;
+            }
+        }
+
+        return dotCount >= 1;
+    }
+}
