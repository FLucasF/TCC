new file mode 100644
index 0000000..aeaaa49
--- /dev/null
+++ b/src/main/java/hotel/messages/MessageRule.java
@@ -0,0 +1,27 @@
+package hotel.messages;
+
+import java.util.List;
+
+/**
+ * A rule about the e-mails the inn sends. A rule may block a message, rewrite it, or ask for extra copies of it;
+ * it only takes part in the modes its scope allows. To add a rule, implement this and list it in {@link EmailSender}.
+ */
+public interface MessageRule {
+
+    RuleScope scope();
+
+    /** Judged on the message as originally requested; a blocked message is kept as is and not sent. */
+    default boolean blocks(Outgoing message) {
+        return false;
+    }
+
+    /** Changes a message that was not blocked. Rewrites run in order, each on the previous result. */
+    default Outgoing rewrite(Outgoing message) {
+        return message;
+    }
+
+    /** Extra messages to send right after the one that went out (judged on the message as sent). */
+    default List<Outgoing> copies(Outgoing message) {
+        return List.of();
+    }
+}
diff --git a/src/main/java/hotel/messages/MessageRules.java b/src/main/java/hotel/messages/MessageRules.java
new file mode 100644
index 0000000..2b4fa22
--- /dev/null
+++ b/src/main/java/hotel/messages/MessageRules.java
@@ -0,0 +1,64 @@
+package hotel.messages;
+
+import java.util.List;
+
+/** The rules in force at the inn. */
+final class MessageRules {
+
+    static final String ARCHIVE_ADDRESS = "arquivo@pousadamarealta.com.br";
+    static final String TEST_ADDRESS = "testes@pousadamarealta.com.br";
+
+    private MessageRules() {
+    }
+
+    static List<MessageRule> standard() {
+        return List.of(new ValidAddress(), new RedirectInTestMode(), new ArchiveCopy());
+    }
+
+    /** A valid address has one "@", something before it, and after it a name with a dot in the middle. */
+    static boolean isValidAddress(String address) {
+        if (address == null) {
+            return false;
+        }
+        int at = address.indexOf('@');
+        if (at < 1 || address.indexOf('@', at + 1) >= 0) {
+            return false;
+        }
+        String domain = address.substring(at + 1);
+        int dot = domain.indexOf('.');
+        return dot > 0 && domain.lastIndexOf('.') < domain.length() - 1;
+    }
+
+    private static final class ValidAddress implements MessageRule {
+        public RuleScope scope() {
+            return RuleScope.ALWAYS;
+        }
+
+        public boolean blocks(Outgoing message) {
+            return !isValidAddress(message.to());
+        }
+    }
+
+    private static final class RedirectInTestMode implements MessageRule {
+        public RuleScope scope() {
+            return RuleScope.TEST_ONLY;
+        }
+
+        public Outgoing rewrite(Outgoing message) {
+            return new Outgoing(
+                    TEST_ADDRESS,
+                    "[TESTE] " + message.subject(),
+                    "Destinatário original: " + message.to() + "\n" + message.body());
+        }
+    }
+
+    private static final class ArchiveCopy implements MessageRule {
+        public RuleScope scope() {
+            return RuleScope.LIVE_ONLY;
+        }
+
+        public List<Outgoing> copies(Outgoing message) {
+            return List.of(new Outgoing(ARCHIVE_ADDRESS, "[Cópia] " + message.subject(), message.body()));
+        }
+    }
+}
