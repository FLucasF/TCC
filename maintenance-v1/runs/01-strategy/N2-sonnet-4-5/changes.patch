+    @Test
+    void longStayApplies10PercentDiscount() {
+        Reservation reservation = service.create(stay(101, "2027-03-01", "2027-03-08", RatePlan.LONG_STAY, null));
+
+        // 7 nights standard: 7 * 249.90 = 1749.30
