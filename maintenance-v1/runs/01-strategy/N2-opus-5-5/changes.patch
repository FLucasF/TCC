diff --git a/src/main/java/hotel/reservations/CorporateRate.java b/src/main/java/hotel/reservations/CorporateRate.java
new file mode 100644
index 0000000..8d85041
--- /dev/null
+++ b/src/main/java/hotel/reservations/CorporateRate.java
@@ -0,0 +1,36 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+import java.util.Map;
+
+/**
+ * The agreement with companies: the guest gives the company's code and gets the company's discount.
+ * Everything paid comes back on cancellation.
+ */
+final class CorporateRate implements RatePlanPolicy {
+
+    static final Map<String, BigDecimal> DISCOUNT_BY_COMPANY = Map.of(
+            "TECNOSUL", new BigDecimal("0.12"),
+            "AGROVALE", new BigDecimal("0.18"),
+            "FARMAVIDA", new BigDecimal("0.25"));
+
+    @Override
+    public void checkEligibility(NewReservation request) {
+        if (request.companyCode() == null || !DISCOUNT_BY_COMPANY.containsKey(request.companyCode())) {
+            throw new HotelException(
+                    ErrorCode.INVALID_REQUEST, "the CORPORATE rate plan needs the code of a partner company");
+        }
+    }
+
+    @Override
+    public Price price(Room room, NewReservation request, PriceCalculator calculator) {
+        return calculator.nightlyRates(room, request.checkIn(), request.checkOut())
+                .withDiscount(DISCOUNT_BY_COMPANY.get(request.companyCode()));
+    }
+
+    @Override
+    public BigDecimal refund(Reservation reservation) {
+        return reservation.amountPaid();
+    }
+}
diff --git a/src/main/java/hotel/reservations/LongStayRate.java b/src/main/java/hotel/reservations/LongStayRate.java
new file mode 100644
index 0000000..edcc5d8
--- /dev/null
+++ b/src/main/java/hotel/reservations/LongStayRate.java
@@ -0,0 +1,31 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+import java.time.temporal.ChronoUnit;
+
+/** 10% off for stays of 7 nights or more; everything paid comes back on cancellation. */
+final class LongStayRate implements RatePlanPolicy {
+
+    static final BigDecimal DISCOUNT = new BigDecimal("0.10");
+    static final int MINIMUM_NIGHTS = 7;
+
+    @Override
+    public void checkEligibility(NewReservation request) {
+        if (ChronoUnit.DAYS.between(request.checkIn(), request.checkOut()) < MINIMUM_NIGHTS) {
+            throw new HotelException(
+                    ErrorCode.INVALID_REQUEST,
+                    "the LONG_STAY rate plan needs at least " + MINIMUM_NIGHTS + " nights");
+        }
+    }
+
+    @Override
+    public Price price(Room room, NewReservation request, PriceCalculator calculator) {
+        return calculator.nightlyRates(room, request.checkIn(), request.checkOut()).withDiscount(DISCOUNT);
+    }
+
+    @Override
+    public BigDecimal refund(Reservation reservation) {
+        return reservation.amountPaid();
+    }
+}
