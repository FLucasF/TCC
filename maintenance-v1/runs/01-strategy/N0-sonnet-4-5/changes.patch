+    private static void validateRatePlan(NewReservation request) {
+        switch (request.ratePlan()) {
+            case CORPORATE -> {
+                if (request.companyCode() == null || request.companyCode().isBlank()) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "corporate rate plan requires a company code");
+                }
+                if (!PriceCalculator.CORPORATE_DISCOUNTS.containsKey(request.companyCode())) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "unknown company code: " + request.companyCode());
+                }
+            }
+            case WEEKEND_PACKAGE -> {
+                long nights = ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+                if (nights != 2) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "weekend package requires exactly 2 nights");
+                }
+                if (request.checkIn().getDayOfWeek() != DayOfWeek.FRIDAY
+                        || request.checkOut().getDayOfWeek() != DayOfWeek.SUNDAY) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "weekend package must be Friday check-in to Sunday check-out");
+                }
+            }
+            case LONG_STAY -> {
+                long nights = ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+                if (nights < 7) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "long stay requires at least 7 nights");
+                }
+            }
+        }
+    }
