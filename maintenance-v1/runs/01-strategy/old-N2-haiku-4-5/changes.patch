+                }
+                break;
+            case WEEKEND_PACKAGE:
+                if (!isWeekendPackageDates(request.checkIn(), request.checkOut())) {
+                    throw new HotelException(ErrorCode.INVALID_REQUEST, "weekend package must be Friday to Sunday");
+                }
+                break;
+            case LONG_STAY:
+                int nights = (int) java.time.temporal.ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+                if (nights < 7) {
