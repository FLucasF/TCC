diff --git a/src/main/java/hotel/reservations/Stay.java b/src/main/java/hotel/reservations/Stay.java
new file mode 100644
index 0000000..b7d775a
--- /dev/null
+++ b/src/main/java/hotel/reservations/Stay.java
@@ -0,0 +1,13 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+
+/** What a rate plan needs to know about a stay to decide if it applies and what it costs. */
+public record Stay(Room room, LocalDate checkIn, LocalDate checkOut, String companyCode) {
+
+    public int nights() {
+        return (int) ChronoUnit.DAYS.between(checkIn, checkOut);
+    }
+}
