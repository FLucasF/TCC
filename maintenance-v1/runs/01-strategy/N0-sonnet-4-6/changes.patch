+    private static void validateRatePlan(NewReservation request) {
+        switch (request.ratePlan()) {
+            case CORPORATE -> {
+                if (request.companyCode() == null
+                        || !PriceCalculator.CORPORATE_DISCOUNTS.containsKey(request.companyCode())) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "invalid or missing company code for CORPORATE rate plan");
+                }
+            }
+            case WEEKEND_PACKAGE -> {
+                boolean fridayCheckIn = request.checkIn().getDayOfWeek() == DayOfWeek.FRIDAY;
+                boolean sundayCheckOut = request.checkOut().equals(request.checkIn().plusDays(2));
+                if (!fridayCheckIn || !sundayCheckOut) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "WEEKEND_PACKAGE requires check-in on Friday and check-out on Sunday (2 nights)");
+                }
+            }
+            case LONG_STAY -> {
+                long nights = java.time.temporal.ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+                if (nights < 7) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "LONG_STAY requires at least 7 nights");
+                }
+            }
+            default -> {}
+        }
+    }
+
     private Room roomOf(Reservation reservation) {
         return rooms.find(reservation.roomNumber()).orElseThrow();
     }
