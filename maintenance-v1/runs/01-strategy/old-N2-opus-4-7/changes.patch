+++ b/src/main/java/hotel/reservations/rateplans/RatePlanPolicies.java
@@ -0,0 +1,23 @@
+package hotel.reservations.rateplans;
+
+import hotel.reservations.RatePlan;
+import java.util.EnumMap;
+import java.util.Map;
+
+/** Registry: tells which {@link RatePlanPolicy} runs for each {@link RatePlan}. */
+public final class RatePlanPolicies {
+
+    private final Map<RatePlan, RatePlanPolicy> policies = new EnumMap<>(RatePlan.class);
+
+    public RatePlanPolicies() {
+        policies.put(RatePlan.STANDARD, new StandardPolicy());
+        policies.put(RatePlan.NON_REFUNDABLE, new NonRefundablePolicy());
+        policies.put(RatePlan.CORPORATE, new CorporatePolicy());
+        policies.put(RatePlan.WEEKEND_PACKAGE, new WeekendPackagePolicy());
+        policies.put(RatePlan.LONG_STAY, new LongStayPolicy());
+    }
+
+    public RatePlanPolicy of(RatePlan plan) {
+        return policies.get(plan);
+    }
+}
diff --git a/src/main/java/hotel/reservations/rateplans/RatePlanPolicy.java b/src/main/java/hotel/reservations/rateplans/RatePlanPolicy.java
new file mode 100644
index 0000000..bf914d9
--- /dev/null
+++ b/src/main/java/hotel/reservations/rateplans/RatePlanPolicy.java
@@ -0,0 +1,25 @@
+package hotel.reservations.rateplans;
+
+import hotel.reservations.NewReservation;
+import hotel.reservations.Price;
+import hotel.reservations.PriceCalculator;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/**
+ * One rate plan's rules in one place: who can book it, how its stay is priced, and how much comes
+ * back when it is cancelled. Adding a new rate plan means adding one of these.
+ */
+public interface RatePlanPolicy {
+
+    /** Rejects a stay the plan does not accept. The default accepts anything the service already allows. */
+    default void validate(NewReservation request, Room room) {}
+
+    /** Full price of the stay under this plan. */
+    Price price(NewReservation request, Room room, PriceCalculator pricing);
+
+    /** What the guest gets back when they cancel. Defaults to the whole paid amount. */
+    default BigDecimal refund(BigDecimal amountPaid, Price price) {
+        return amountPaid;
+    }
+}
