+    private void validateRatePlan(NewReservation request) {
+        switch (request.ratePlan()) {
+            case CORPORATE:
+                if (request.companyCode() == null || !isValidCorporateCode(request.companyCode())) {
+                    throw new HotelException(ErrorCode.INVALID_REQUEST, "invalid company code for CORPORATE plan");
+                }
+                break;
+            case WEEKEND_PACKAGE:
+                if (!isWeekendPackageValid(request.checkIn(), request.checkOut())) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST,
+                            "WEEKEND_PACKAGE must be Friday to Sunday (exactly 2 nights)");
+                }
+                break;
+            case LONG_STAY:
+                int nights = (int) java.time.temporal.ChronoUnit.DAYS.between(request.checkIn(), request.checkOut());
+                if (nights < 7) {
+                    throw new HotelException(
+                            ErrorCode.INVALID_REQUEST, "LONG_STAY requires at least 7 nights");
+                }
+                break;
+            default:
+                break;
+        }
+    }
+
+    private boolean isValidCorporateCode(String code) {
+        return code.equals("TECNOSUL") || code.equals("AGROVALE") || code.equals("FARMAVIDA");
+    }
+
+    private boolean isWeekendPackageValid(java.time.LocalDate checkIn, java.time.LocalDate checkOut) {
+        java.time.DayOfWeek startDay = checkIn.getDayOfWeek();
+        java.time.DayOfWeek endDay = checkOut.getDayOfWeek();
+        int nights = (int) java.time.temporal.ChronoUnit.DAYS.between(checkIn, checkOut);
+        return startDay == java.time.DayOfWeek.FRIDAY && endDay == java.time.DayOfWeek.SUNDAY && nights == 2;
+    }
+
+    private BigDecimal calculateRefund(Reservation reservation) {
+        return switch (reservation.ratePlan()) {
+            case STANDARD -> reservation.amountPaid();
+            case NON_REFUNDABLE -> PriceCalculator.cents(BigDecimal.ZERO);
+            case CORPORATE -> reservation.amountPaid();
+            case WEEKEND_PACKAGE -> PriceCalculator.cents(
+                    reservation.amountPaid().multiply(new BigDecimal("0.5")));
+            case LONG_STAY -> reservation.amountPaid();
+        };
+    }
+
