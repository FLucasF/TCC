     static final BigDecimal NON_REFUNDABLE_DISCOUNT = new BigDecimal("0.15");
+    static final BigDecimal LONG_STAY_DISCOUNT = new BigDecimal("0.10");
+
+    private static final java.util.Map<String, BigDecimal> CORPORATE_DISCOUNTS = java.util.Map.of(
+            "TECNOSUL", new BigDecimal("0.12"),
+            "AGROVALE", new BigDecimal("0.18"),
+            "FARMAVIDA", new BigDecimal("0.25"));
+
+    private static final java.util.Map<RoomType, BigDecimal> WEEKEND_PACKAGE_PRICES = java.util.Map.of(
+            RoomType.STANDARD, new BigDecimal("520.00"),
