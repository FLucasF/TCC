+    /** High season: from December 15 to the end of February, the whole of July, and Easter week. */
     static boolean isHighSeason(LocalDate date) {
         Month month = date.getMonth();
-        return month == Month.JANUARY
+        boolean isMainHighSeason = month == Month.JANUARY
                 || month == Month.FEBRUARY
                 || month == Month.JULY
                 || (month == Month.DECEMBER && date.getDayOfMonth() >= 15);
+        if (isMainHighSeason) {
+            return true;
+        }
+        return isEasterWeek(date);
+    }
+
+    private static boolean isEasterWeek(LocalDate date) {
+        LocalDate easter = calculateEaster(date.getYear());
+        LocalDate sundayOfRamps = easter.minusDays(7);
+        LocalDate sundayOfEaster = easter;
+        return !date.isBefore(sundayOfRamps) && !date.isAfter(sundayOfEaster);
+    }
+
+    private static LocalDate calculateEaster(int year) {
+        int a = year % 19;
+        int b = year / 100;
+        int c = year % 100;
+        int d = b / 4;
+        int e = b % 4;
+        int f = (b + 8) / 25;
+        int g = (b - f + 1) / 3;
+        int h = (19 * a + b - d - g + 15) % 30;
+        int i = c / 4;
+        int k = c % 4;
+        int l = (32 + 2 * e + 2 * i - h - k) % 7;
+        int m = (a + 11 * h + 22 * l) / 451;
+        int month = (h + l - 7 * m + 114) / 31;
+        int day = ((h + l - 7 * m + 114) % 31) + 1;
+        return LocalDate.of(year, month, day);
     }
 
