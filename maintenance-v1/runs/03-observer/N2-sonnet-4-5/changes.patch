diff --git a/src/main/java/hotel/notifications/FinanceNotifier.java b/src/main/java/hotel/notifications/FinanceNotifier.java
new file mode 100644
index 0000000..1684d05
--- /dev/null
+++ b/src/main/java/hotel/notifications/FinanceNotifier.java
@@ -0,0 +1,41 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationObserver;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+/** Notifies finance when payments are received or refunds are due. */
+public final class FinanceNotifier implements ReservationObserver {
+
+    private static final String FINANCE_EMAIL = "financeiro@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public FinanceNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmation(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Um pagamento foi recebido:\n\n"
+                + "Reserva: " + reservation.id() + "\n"
+                + "Valor: " + TextFormat.money(reservation.amountPaid()) + "\n";
+        emailSender.send(FINANCE_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onCancellation(Reservation reservation, Room room) {
+        BigDecimal refund = reservation.refund();
+        if (refund != null && refund.compareTo(BigDecimal.ZERO) > 0) {
+            String subject = "Reembolso - reserva " + reservation.id();
+            String body = "Um reembolso deve ser feito:\n\n"
+                    + "Reserva: " + reservation.id() + "\n"
+                    + "Valor a devolver: " + TextFormat.money(refund) + "\n";
+            emailSender.send(FINANCE_EMAIL, subject, body);
+        }
+    }
+}
diff --git a/src/main/java/hotel/notifications/HousekeepingNotifier.java b/src/main/java/hotel/notifications/HousekeepingNotifier.java
new file mode 100644
index 0000000..1de5719
--- /dev/null
+++ b/src/main/java/hotel/notifications/HousekeepingNotifier.java
@@ -0,0 +1,40 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationObserver;
+import hotel.rooms.Room;
+
+/** Notifies housekeeping when reservations are confirmed or cancelled. */
+public final class HousekeepingNotifier implements ReservationObserver {
+
+    private static final String HOUSEKEEPING_EMAIL = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public HousekeepingNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmation(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + room.number();
+        String body = "Uma reserva foi confirmada:\n\n"
+                + "Quarto: " + room.number() + "\n"
+                + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests() + "\n";
+        emailSender.send(HOUSEKEEPING_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onCancellation(Reservation reservation, Room room) {
+        String subject = "Reserva cancelada - quarto " + room.number();
+        String body = "Uma reserva foi cancelada:\n\n"
+                + "Quarto: " + room.number() + "\n"
+                + "Datas livres: " + TextFormat.date(reservation.checkIn())
+                + " a " + TextFormat.date(reservation.checkOut()) + "\n";
+        emailSender.send(HOUSEKEEPING_EMAIL, subject, body);
+    }
+}
diff --git a/src/main/java/hotel/reservations/ReservationObserver.java b/src/main/java/hotel/reservations/ReservationObserver.java
new file mode 100644
index 0000000..369cb6b
--- /dev/null
+++ b/src/main/java/hotel/reservations/ReservationObserver.java
@@ -0,0 +1,13 @@
+package hotel.reservations;
+
+import hotel.rooms.Room;
+
+/** Observes reservation state changes and reacts to them. */
+public interface ReservationObserver {
+
+    /** Called when a reservation is confirmed (the guest paid). */
+    void onConfirmation(Reservation reservation, Room room);
+
+    /** Called when a confirmed reservation is cancelled. */
+    void onCancellation(Reservation reservation, Room room);
+}
