new file mode 100644
index 0000000..36813b6
--- /dev/null
+++ b/src/main/java/hotel/reservations/FinanceNotifier.java
@@ -0,0 +1,33 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+/** Notifies finance when a reservation is confirmed or cancelled. */
+public final class FinanceNotifier implements ReservationEventHandler {
+
+    private static final String EMAIL = "financeiro@pousadamarealta.com.br";
+    private final EmailSender emailSender;
+
+    public FinanceNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        String subject = "Pagamento recebido - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.amountPaid()) + "\n";
+        emailSender.send(EMAIL, subject, body);
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room) {
+        if (reservation.refund() == null || reservation.refund().signum() == 0) {
+            return;
+        }
+        String subject = "Reembolso - reserva " + reservation.id();
+        String body = "Valor: " + TextFormat.money(reservation.refund()) + "\n";
+        emailSender.send(EMAIL, subject, body);
+    }
+}
diff --git a/src/main/java/hotel/reservations/GovernanceNotifier.java b/src/main/java/hotel/reservations/GovernanceNotifier.java
new file mode 100644
index 0000000..b6f6065
--- /dev/null
+++ b/src/main/java/hotel/reservations/GovernanceNotifier.java
@@ -0,0 +1,38 @@
+package hotel.reservations;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.rooms.Room;
+
+/** Notifies governance when a reservation is confirmed or cancelled. */
+public final class GovernanceNotifier implements ReservationEventHandler {
+
+    private static final String EMAIL = "governanca@pousadamarealta.com.br";
+    private final EmailSender emailSender;
+
+    public GovernanceNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + room.number();
+        String body = "Quarto: " + room.number() + "\n"
+                + "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests() + "\n";
+        emailSender.send(EMAIL, subject, body);
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room) {
+        if (reservation.status() != ReservationStatus.CANCELLED) {
+            return;
+        }
+        String subject = "Reserva cancelada - quarto " + room.number();
+        String body = "Quarto: " + room.number() + "\n"
+                + "Datas liberadas: " + TextFormat.date(reservation.checkIn())
+                + " a " + TextFormat.date(reservation.checkOut()) + "\n";
+        emailSender.send(EMAIL, subject, body);
+    }
+}
