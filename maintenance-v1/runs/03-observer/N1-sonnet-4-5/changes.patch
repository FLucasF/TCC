@@ -0,0 +1,35 @@
+package hotel.notifications;
+
+import hotel.documents.TextFormat;
+import hotel.messages.EmailSender;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+
+public final class HousekeepingNotifier implements ReservationNotifier {
+
+    private static final String HOUSEKEEPING_EMAIL = "governanca@pousadamarealta.com.br";
+
+    private final EmailSender emailSender;
+
+    public HousekeepingNotifier(EmailSender emailSender) {
+        this.emailSender = emailSender;
+    }
+
+    @Override
+    public void onConfirmed(Reservation reservation, Room room) {
+        String subject = "Reserva confirmada - quarto " + room.number();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n"
+                + "Hóspedes: " + reservation.guests() + "\n";
+        emailSender.send(HOUSEKEEPING_EMAIL, subject, body);
+    }
+
+    @Override
+    public void onCancelled(Reservation reservation, Room room, BigDecimal refund) {
+        String subject = "Reserva cancelada - quarto " + room.number();
+        String body = "Entrada: " + TextFormat.date(reservation.checkIn()) + "\n"
+                + "Saída: " + TextFormat.date(reservation.checkOut()) + "\n";
+        emailSender.send(HOUSEKEEPING_EMAIL, subject, body);
+    }
+}
diff --git a/src/main/java/hotel/notifications/ReservationNotifications.java b/src/main/java/hotel/notifications/ReservationNotifications.java
new file mode 100644
index 0000000..9019c96
--- /dev/null
+++ b/src/main/java/hotel/notifications/ReservationNotifications.java
@@ -0,0 +1,32 @@
+package hotel.notifications;
+
+import hotel.reservations.Reservation;
+import hotel.reservations.ReservationStatus;
+import hotel.rooms.Room;
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class ReservationNotifications {
+
+    private final List<ReservationNotifier> notifiers;
+
+    public ReservationNotifications(List<ReservationNotifier> notifiers) {
+        this.notifiers = new ArrayList<>(notifiers);
+    }
+
+    public void notifyConfirmed(Reservation reservation, Room room) {
+        for (ReservationNotifier notifier : notifiers) {
+            notifier.onConfirmed(reservation, room);
+        }
+    }
+
+    public void notifyCancelled(Reservation reservation, Room room, BigDecimal refund,
+            ReservationStatus previousStatus) {
+        if (previousStatus == ReservationStatus.CONFIRMED) {
+            for (ReservationNotifier notifier : notifiers) {
+                notifier.onCancelled(reservation, room, refund);
+            }
+        }
+    }
+}
