+
+        boolean hasCpf = !isBlank(body.guestCpf());
+        boolean hasCnpj = !isBlank(body.companyCnpj());
+        boolean hasCompanyName = !isBlank(body.companyName());
+        boolean hasPassport = !isBlank(body.guestPassport());
+        boolean hasCountry = !isBlank(body.guestCountry());
+
+        int identificationTypes = 0;
+        if (hasCpf) identificationTypes++;
+        if (hasCnpj || hasCompanyName) identificationTypes++;
+        if (hasPassport || hasCountry) identificationTypes++;
+
+        if (identificationTypes != 1) {
+            throw new HotelException(ErrorCode.INVALID_REQUEST,
+                "provide either guestCpf, or companyCnpj and companyName, or guestPassport and guestCountry");
+        }
+
+        if (hasCnpj != hasCompanyName) {
+            throw new HotelException(ErrorCode.INVALID_REQUEST,
+                "companyCnpj and companyName must be provided together");
+        }
+
+        if (hasPassport != hasCountry) {
+            throw new HotelException(ErrorCode.INVALID_REQUEST,
+                "guestPassport and guestCountry must be provided together");
+        }
+
+        Guest guest = new Guest(
+                body.guestName(),
+                body.guestEmail(),
