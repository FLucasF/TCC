 package hotel.reservations;
 
-public record Guest(String name, String email, String cpf) {
+public record Guest(String name, String email, GuestIdentity identity) {
+
+    public Guest(String name, String email, String cpf) {
+        this(name, email, new GuestIdentity.Cpf(cpf));
+    }
+
+    /** Null when the guest is not identified by CPF; the same goes for the accessors below. */
+    public String cpf() {
+        return identity instanceof GuestIdentity.Cpf id ? id.cpf() : null;
+    }
+
+    public String companyCnpj() {
+        return identity instanceof GuestIdentity.Company id ? id.cnpj() : null;
+    }
+
+    public String companyName() {
+        return identity instanceof GuestIdentity.Company id ? id.companyName() : null;
+    }
+
+    public String passport() {
+        return identity instanceof GuestIdentity.Passport id ? id.number() : null;
+    }
+
+    public String country() {
+        return identity instanceof GuestIdentity.Passport id ? id.country() : null;
+    }
 }
diff --git a/src/main/java/hotel/reservations/GuestIdentity.java b/src/main/java/hotel/reservations/GuestIdentity.java
new file mode 100644
index 0000000..e27b9fb
--- /dev/null
+++ b/src/main/java/hotel/reservations/GuestIdentity.java
@@ -0,0 +1,17 @@
+package hotel.reservations;
+
+/** How the guest is identified on the reservation and on the document: exactly one of these. */
+public sealed interface GuestIdentity {
+
+    /** A Brazilian individual. */
+    record Cpf(String cpf) implements GuestIdentity {
+    }
+
+    /** A company booking the room for the guest, who gets the invoice with the company's data. */
+    record Company(String cnpj, String companyName) implements GuestIdentity {
+    }
+
+    /** A foreign guest. */
+    record Passport(String number, String country) implements GuestIdentity {
+    }
+}
