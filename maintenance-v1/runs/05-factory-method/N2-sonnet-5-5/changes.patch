@@ -0,0 +1,39 @@
+package hotel.documents;
+
+/** The receipt for a guest with CPF, in Portuguese. The invoice builds on it. */
+class ReceiptLayout implements DocumentLayout {
+
+    @Override
+    public String title() {
+        return "Comprovante de reserva";
+    }
+
+    @Override
+    public String text(ReservationDocument document) {
+        StringBuilder text = new StringBuilder();
+        text.append(document.title()).append(" nº ").append(document.reservationId()).append('\n');
+        text.append(identification(document));
+        text.append("Quarto: ").append(document.roomNumber()).append(" (").append(document.roomType()).append(")\n");
+        text.append("Entrada: ").append(TextFormat.date(document.checkIn()))
+                .append(" | Saída: ").append(TextFormat.date(document.checkOut()))
+                .append(" | ").append(document.nights()).append(document.nights() == 1 ? " diária" : " diárias")
+                .append('\n');
+        text.append("Diárias: ").append(TextFormat.money(document.subtotal())).append('\n');
+        if (document.discount().signum() > 0) {
+            text.append("Desconto: ").append(TextFormat.money(document.discount())).append('\n');
+        }
+        text.append("Total: ").append(TextFormat.money(document.total())).append('\n');
+        text.append(closing(document));
+        return text.toString();
+    }
+
+    /** The lines that say who the document is for. */
+    String identification(ReservationDocument document) {
+        return "Hóspede: " + document.guestName() + " (CPF " + document.guestCpf() + ")\n";
+    }
+
+    /** The lines after the total. */
+    String closing(ReservationDocument document) {
+        return "";
+    }
+}
diff --git a/src/main/java/hotel/documents/ReservationDocument.java b/src/main/java/hotel/documents/ReservationDocument.java
new file mode 100644
index 0000000..6f1f840
--- /dev/null
+++ b/src/main/java/hotel/documents/ReservationDocument.java
@@ -0,0 +1,61 @@
+package hotel.documents;
+
+import hotel.reservations.Identification;
+import hotel.reservations.Reservation;
+import hotel.rooms.Room;
+import hotel.rooms.RoomType;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/**
+ * The document the guest gets when the reservation is confirmed, at check-out, and on request. Which
+ * document it is (receipt, invoice, booking receipt) depends on how the guest is identified.
+ */
+public record ReservationDocument(
+        String title,
+        long reservationId,
+        String guestName,
+        String guestCpf,
+        String companyCnpj,
+        String companyName,
+        String guestPassport,
+        String guestCountry,
+        int roomNumber,
+        RoomType roomType,
+        LocalDate checkIn,
+        LocalDate checkOut,
+        int nights,
+        BigDecimal subtotal,
+        BigDecimal discount,
+        BigDecimal total,
+        String text) {
+
+    static ReservationDocument issue(Reservation reservation, Room room, DocumentLayout layout) {
+        Identification identification = reservation.guest().identification();
+        ReservationDocument draft = new ReservationDocument(
+                layout.title(),
+                reservation.id(),
+                reservation.guest().name(),
+                identification.cpf(),
+                identification.cnpj(),
+                identification.companyName(),
+                identification.passport(),
+                identification.country(),
+                room.number(),
+                room.type(),
+                reservation.checkIn(),
+                reservation.checkOut(),
+                reservation.price().nights(),
+                reservation.price().subtotal(),
+                reservation.price().discount(),
+                reservation.price().total(),
+                null);
+        return draft.withText(layout.text(draft));
+    }
+
+    private ReservationDocument withText(String newText) {
+        return new ReservationDocument(
+                title, reservationId, guestName, guestCpf, companyCnpj, companyName, guestPassport, guestCountry,
+                roomNumber, roomType, checkIn, checkOut, nights, subtotal, discount, total, newText);
+    }
+}
