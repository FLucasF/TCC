+        long id = reservation.get("id").asLong();
+        assertEquals("12.345.678/0001-90", reservation.get("companyCnpj").asText());
+        assertEquals("Tecnosul Ltda", reservation.get("companyName").asText());
+        assertTrue(reservation.get("guestCpf").isNull());
+
+        post("/reservations/" + id + "/confirmation", "");
+        HttpResponse<String> document = get("/reservations/" + id + "/document");
+        assertEquals(200, document.statusCode());
+        JsonNode receipt = json.readTree(document.body());
+        assertEquals("Fatura de hospedagem", receipt.get("title").asText());
+        assertTrue(receipt.get("text").asText().contains("Empresa: Tecnosul Ltda"));
+        assertTrue(receipt.get("text").asText().contains("ISS retido (5%)"));
+    }
+
+    @Test
+    void createsReservationWithPassport() throws Exception {
+        String foreignReservation = """
+                {"roomNumber": 202, "guestName": "John Smith", "guestEmail": "john@example.com",
+                 "guestPassport": "X1234567", "guestCountry": "United Kingdom",
+                 "checkIn": "2027-03-10", "checkOut": "2027-03-12", "guests": 2, "ratePlan": "STANDARD"}
+                """;
+
+        HttpResponse<String> created = post("/reservations", foreignReservation);
+        assertEquals(201, created.statusCode());
+        JsonNode reservation = json.readTree(created.body());
+        long id = reservation.get("id").asLong();
+        assertEquals("X1234567", reservation.get("guestPassport").asText());
+        assertEquals("United Kingdom", reservation.get("guestCountry").asText());
+        assertTrue(reservation.get("guestCpf").isNull());
+
+        post("/reservations/" + id + "/confirmation", "");
+        HttpResponse<String> document = get("/reservations/" + id + "/document");
+        assertEquals(200, document.statusCode());
+        JsonNode receipt = json.readTree(document.body());
+        assertEquals("Booking receipt", receipt.get("title").asText());
+        assertTrue(receipt.get("text").asText().contains("Guest: John Smith"));
+        assertTrue(receipt.get("text").asText().contains("passport X1234567"));
+        assertTrue(receipt.get("text").asText().contains("BRL "));
+    }
+
+    @Test
+    void rejectsReservationWithMultipleIdentifications() throws Exception {
+        String invalidReservation = """
+                {"roomNumber": 201, "guestName": "Ana", "guestEmail": "ana@example.com",
+                 "guestCpf": "111.222.333-44", "companyCnpj": "12.345.678/0001-90", "companyName": "Tecnosul",
+                 "checkIn": "2027-03-10", "checkOut": "2027-03-12", "guests": 2, "ratePlan": "STANDARD"}
+                """;
+
