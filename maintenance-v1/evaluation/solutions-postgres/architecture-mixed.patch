diff --git a/src/test/java/hotel/reservations/NewRatePlansTest.java b/src/test/java/hotel/reservations/NewRatePlansTest.java
new file mode 100644
index 0000000..dd34a37
--- /dev/null
+++ b/src/test/java/hotel/reservations/NewRatePlansTest.java
@@ -0,0 +1,122 @@
+package hotel.reservations;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import hotel.EmptyDatabase;
+import hotel.messages.EmailSender;
+import hotel.messages.SentMessages;
+import hotel.rooms.Rooms;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+class NewRatePlansTest {
+
+    private final EmptyDatabase database = new EmptyDatabase();
+    private final RatePlans ratePlans = new RatePlans();
+    private final ReservationService service = new ReservationService(new Rooms(database.dataSource()),
+            new ReservationStore(database.dataSource()), new PriceCalculator(ratePlans), ratePlans,
+            new EmailSender(new SentMessages(database.dataSource())));
+
+    @AfterEach
+    void closeDatabase() {
+        database.close();
+    }
+
+    private Reservation book(int room, String checkIn, String checkOut, RatePlan plan, String companyCode) {
+        Guest guest = new Guest("Ana Souza", "ana@example.com", "123.456.789-09");
+        return service.create(new NewReservation(
+                room, guest, LocalDate.parse(checkIn), LocalDate.parse(checkOut), 1, plan, companyCode));
+    }
+
+    private BigDecimal refundAfterPaying(Reservation reservation) {
+        service.confirm(reservation.id());
+        return service.cancel(reservation.id()).refund();
+    }
+
+    private static ErrorCode errorOf(Runnable action) {
+        return assertThrows(HotelException.class, action::run).errorCode();
+    }
+
+    @Test
+    void eachCompanyHasItsOwnDiscount() {
+        Reservation tecnosul = book(201, "2027-03-10", "2027-03-12", RatePlan.CORPORATE, "TECNOSUL");
+        Reservation agrovale = book(202, "2027-03-10", "2027-03-12", RatePlan.CORPORATE, "AGROVALE");
+        Reservation farmavida = book(201, "2027-03-20", "2027-03-22", RatePlan.CORPORATE, "FARMAVIDA");
+
+        assertEquals(new BigDecimal("779.80"), tecnosul.price().subtotal());
+        assertEquals(new BigDecimal("93.58"), tecnosul.price().discount());
+        assertEquals(new BigDecimal("686.22"), tecnosul.price().total());
+        assertEquals(new BigDecimal("140.36"), agrovale.price().discount());
+        assertEquals(new BigDecimal("639.44"), agrovale.price().total());
+        assertEquals(new BigDecimal("194.95"), farmavida.price().discount());
+        assertEquals(new BigDecimal("584.85"), farmavida.price().total());
+    }
+
+    @Test
+    void corporateNeedsAKnownCompanyAndGivesEverythingBack() {
+        assertEquals(ErrorCode.INVALID_REQUEST,
+                errorOf(() -> book(201, "2027-03-10", "2027-03-12", RatePlan.CORPORATE, null)));
+        assertEquals(ErrorCode.INVALID_REQUEST,
+                errorOf(() -> book(201, "2027-03-10", "2027-03-12", RatePlan.CORPORATE, "ACME")));
+
+        Reservation reservation = book(201, "2027-03-10", "2027-03-12", RatePlan.CORPORATE, "TECNOSUL");
+        assertEquals(new BigDecimal("686.22"), refundAfterPaying(reservation));
+    }
+
+    @Test
+    void theWeekendPackageIsAFixedPricePerRoomTypeAllYear() {
+        Reservation deluxe = book(201, "2027-03-12", "2027-03-14", RatePlan.WEEKEND_PACKAGE, null);
+        Reservation standard = book(101, "2027-03-19", "2027-03-21", RatePlan.WEEKEND_PACKAGE, null);
+        Reservation suite = book(301, "2027-03-19", "2027-03-21", RatePlan.WEEKEND_PACKAGE, null);
+        Reservation july = book(202, "2027-07-09", "2027-07-11", RatePlan.WEEKEND_PACKAGE, null);
+
+        assertEquals(new BigDecimal("820.00"), deluxe.price().subtotal());
+        assertEquals(new BigDecimal("0.00"), deluxe.price().discount());
+        assertEquals(new BigDecimal("820.00"), deluxe.price().total());
+        assertEquals(new BigDecimal("520.00"), standard.price().total());
+        assertEquals(new BigDecimal("1200.00"), suite.price().total());
+        assertEquals(new BigDecimal("820.00"), july.price().total());
+        assertEquals(new BigDecimal("410.00"), refundAfterPaying(deluxe));
+    }
+
+    @Test
+    void theWeekendPackageGoesFromFridayToTheSundayRightAfter() {
+        assertEquals(ErrorCode.INVALID_REQUEST,
+                errorOf(() -> book(202, "2027-03-13", "2027-03-15", RatePlan.WEEKEND_PACKAGE, null)));
+        assertEquals(ErrorCode.INVALID_REQUEST,
+                errorOf(() -> book(202, "2027-03-26", "2027-03-29", RatePlan.WEEKEND_PACKAGE, null)));
+        assertEquals(ErrorCode.INVALID_REQUEST,
+                errorOf(() -> book(202, "2027-03-12", "2027-03-13", RatePlan.WEEKEND_PACKAGE, null)));
+    }
+
+    @Test
+    void theLongStayTakesTenPercentOffAndKeepsTheHighSeason() {
+        Reservation march = book(101, "2027-03-01", "2027-03-08", RatePlan.LONG_STAY, null);
+        Reservation summer = book(102, "2027-06-28", "2027-07-05", RatePlan.LONG_STAY, null);
+
+        assertEquals(new BigDecimal("1749.30"), march.price().subtotal());
+        assertEquals(new BigDecimal("174.93"), march.price().discount());
+        assertEquals(new BigDecimal("1574.37"), march.price().total());
+        // June 28 to 30 at 249.90, July 1 to 4 at 299.88
+        assertEquals(new BigDecimal("1949.22"), summer.price().subtotal());
+        assertEquals(new BigDecimal("1754.30"), summer.price().total());
+        assertEquals(new BigDecimal("1574.37"), refundAfterPaying(march));
+    }
+
+    @Test
+    void theLongStayNeedsSevenNights() {
+        assertEquals(ErrorCode.INVALID_REQUEST,
+                errorOf(() -> book(102, "2027-04-01", "2027-04-07", RatePlan.LONG_STAY, null)));
+    }
+
+    @Test
+    void theCompanyCodeIsIgnoredOutsideCorporate() {
+        Reservation reservation = book(102, "2027-05-10", "2027-05-12", RatePlan.STANDARD, "TECNOSUL");
+
+        assertEquals(new BigDecimal("0.00"), reservation.price().discount());
+        assertEquals(new BigDecimal("0.00"), service.find(reservation.id()).price().discount());
+    }
+}
