  "constraints": [
    {
      "table": "customers",
      "name": "customers_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (cpf)"
    },
    {
      "table": "notifications",
      "name": "notifications_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "notifications",
      "name": "notifications_status_check",
      "type": "c",
      "definition": "CHECK (((status)::text = ANY ((ARRAY['NEW'::character varying, 'READ'::character varying])::text[])))"
    },
    {
      "table": "notifications",
      "name": "notifications_type_check",
      "type": "c",
      "definition": "CHECK (((type)::text = ANY ((ARRAY['PAYMENT_APPROVED'::character varying, 'ORDER_SHIPPED'::character varying, 'ORDER_CANCELLED'::character varying])::text[])))"
    },
    {
      "table": "order_items",
      "name": "fkbioxgbv59vetrxe0ejfubep1w",
      "type": "f",
      "definition": "FOREIGN KEY (order_id) REFERENCES orders(id)"
    },
    {
      "table": "order_items",
      "name": "order_items_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "orders",
      "name": "orders_club_tier_check",
      "type": "c",
      "definition": "CHECK (((club_tier)::text = ANY ((ARRAY['BRONZE'::character varying, 'SILVER'::character varying, 'GOLD'::character varying])::text[])))"
    },
    {
      "table": "orders",
      "name": "orders_coupon_check",
      "type": "c",
      "definition": "CHECK (((coupon)::text = ANY ((ARRAY['WELCOME10'::character varying, 'MINUS50'::character varying, 'FREESHIPPING'::character varying, 'BUY3PAY2'::character varying])::text[])))"
    },
    {
      "table": "orders",
      "name": "orders_payment_method_check",
      "type": "c",
      "definition": "CHECK (((payment_method)::text = ANY ((ARRAY['PIX'::character varying, 'CREDIT_CARD'::character varying, 'BANK_SLIP'::character varying])::text[])))"
    },
    {
      "table": "orders",
      "name": "orders_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "orders",
      "name": "orders_region_check",
      "type": "c",
      "definition": "CHECK (((region)::text = ANY ((ARRAY['SOUTHEAST'::character varying, 'SOUTH'::character varying, 'MIDWEST'::character varying, 'NORTH'::character varying, 'NORTHEAST'::character varying])::text[])))"
    },
    {
      "table": "orders",
      "name": "orders_shipping_method_check",
      "type": "c",
      "definition": "CHECK (((shipping_method)::text = ANY ((ARRAY['ECONOMY'::character varying, 'EXPRESS'::character varying, 'STORE_PICKUP'::character varying, 'COURIER'::character varying])::text[])))"
    },
    {
      "table": "orders",
      "name": "orders_status_check",
      "type": "c",
      "definition": "CHECK (((status)::text = ANY ((ARRAY['AWAITING_PAYMENT'::character varying, 'PAID'::character varying, 'SHIPPED'::character varying, 'DELIVERED'::character varying, 'CANCELLED'::character varying])::text[])))"
    },
    {
      "table": "products",
      "name": "products_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (sku)"
    }
