{
  "boundaries": [
    {
      "id": "backend",
      "paths": ["apps/backend/src/**"],
      "workingDirectory": "apps/backend",
      "fast": [
        {
          "run": "npx --yes jscpd src/main --min-tokens 100 --reporters ai",
          "prerequisites": ["npx"],
          "filterToTouched": true,
          "reportOnly": true
        }
      ],
      "commands": [
        { "run": "mvn -B -q test", "prerequisites": ["mvn", "java"] }
      ]
    },

    {
      "id": "frontend",
      "paths": ["apps/frontend/src/**"],
      "workingDirectory": "apps/frontend",
      "fast": [
        { "run": "npm run typecheck", "prerequisites": ["npm"] }
      ],
      "commands": [
        { "run": "npm run build", "prerequisites": ["npm"] }
      ]
    },

    {
      "id": "harness",
      "paths": ["*.md", ".claude/**", "verify/**"],
      "workingDirectory": ".",
      "commands": []
    }
  ],

  "unmappedPathPolicy": "report"
}
