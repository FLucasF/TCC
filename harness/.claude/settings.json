{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "PowerShell(Remove-Item*-Recurse*-Force*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/credentials.json)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(rm -r *)",
      "PowerShell(Remove-Item*-Recurse*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/verify/runner.py",
              "--hook"
            ],
            "timeout": 120,
            "statusMessage": "harness: verificação rápida"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/verify/runner.py",
              "--gate"
            ],
            "timeout": 600,
            "statusMessage": "harness: portão de conclusão"
          }
        ]
      }
    ]
  }
}
